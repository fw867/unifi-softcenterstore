#!/bin/sh
# UniFi SoftCenter · XWall 运行状态排查（只读诊断，不做任何修改）
#
# 用法：
#   xwall-status          控制台/面板「扩展 → 运行状态排查」用的文本报告（带柱状图）
#   xwall-status --json   结构化输出（面板 Web 运行状态面板用，前端渲染成图表）
#
# 内容：
#   0. 概要（进程 / 运行时长 / 内存 / 代理模式 / DNS）
#   1. 连接总览（TCP/UDP 总数 + 文件描述符占用）
#   2. 协议占比
#   3. TCP 状态分布（排查假死 / 网络堵塞）
#   4. 端口分布（远端目标端口 Top10 + 本地端口 Top5）
#   5. 局域网设备占用 Top10（conntrack UDP，含客户端名称与 MAC）
#   6. 劫持规则与白名单状态（只读）
#   7. 结论
#
# 注意：运行在路由器的 /bin/sh（busybox ash）上，只能用 POSIX 语法。

PATH="${XWALL_PATH_PREFIX:+$XWALL_PATH_PREFIX:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

PROC_NAME="xwall-xray"
PROC_ROOT="${XWALL_PROC:-/proc}"        # 便于离线测试，默认 /proc
CONFIG="/data/softcenter/config/xwall.env"
CHAIN="XWALL"
IPSET_BYPASS="xwall_bypass"
ROUTE_TABLE="320"
TCP_PORT="1280"
UDP_PORT="1281"
BAR_W=22
# DHCP 租约文件（UniFi OS / dnsmasq / busybox udhcpd 常见位置）
LEASE_FILES="${XWALL_LEASE_FILES:-/var/lib/misc/dnsmasq.leases /run/dnsmasq/dnsmasq.leases /var/run/dnsmasq/dnsmasq.leases /var/run/udhcpd.leases /tmp/dhcpd.leases /var/run/dhcpd.leases /var/lib/dhcp/dhcpd.leases}"

JSON_MODE=0
[ "${1:-}" = "--json" ] && JSON_MODE=1

[ -f "$CONFIG" ] && . "$CONFIG" 2>/dev/null
PROXY_MODE="${PROXY_MODE:-2}"
DNS_CN="${DNS_CN:-223.5.5.5}"
DNS_FOREIGN="${DNS_FOREIGN:-8.8.8.8}"
DNS_HIJACK="${DNS_HIJACK:-0}"
XRAY_LOG_LEVEL="${XRAY_LOG_LEVEL:-warning}"
XWALL_SOCKS_ENABLE="${XWALL_SOCKS_ENABLE:-0}"

# ---------- 小工具 ----------
section() {
    printf '\n── %s ─────────────────────────────\n' "$1"
}

# 柱状图：bar <值> <最大值> [宽度]
bar() {
    _v="$1"
    _max="$2"
    _w="${3:-$BAR_W}"
    [ "$_max" -le 0 ] 2>/dev/null && _max=1
    _n=$((_v * _w / _max))
    [ "$_n" -lt 0 ] && _n=0
    [ "$_n" -gt "$_w" ] && _n=$_w
    _i=0
    _s=""
    while [ "$_i" -lt "$_w" ]; do
        if [ "$_i" -lt "$_n" ]; then
            _s="$_s█"
        else
            _s="$_s░"
        fi
        _i=$((_i + 1))
    done
    printf '%s' "$_s"
}

# 百分比数值（不带 %）：pctnum <值> <总数>（四舍五入到 0.1）
pctnum() {
    _v="$1"
    _t="$2"
    [ "$_t" -le 0 ] 2>/dev/null && _t=1
    _p=$(( (_v * 2000 / _t + 1) / 2 ))
    printf '%d.%d' "$((_p / 10))" "$((_p % 10))"
}

# 百分比（带 %）：给文本报告用
pct() {
    printf '%s%%' "$(pctnum "$1" "$2")"
}

# 端口助记
port_name() {
    case "$1" in
        443) echo "https" ;;
        80) echo "http" ;;
        53) echo "dns" ;;
        123) echo "ntp" ;;
        853) echo "dot" ;;
        8080) echo "http-alt" ;;
        8443) echo "https-alt" ;;
        "$TCP_PORT") echo "xwall-tcp" ;;
        "$UDP_PORT") echo "xwall-udp" ;;
        15353) echo "xwall-dns" ;;
        *) echo "-" ;;
    esac
}

# TCP 状态全称（ss 输出的是缩写）
state_name() {
    case "$1" in
        ESTAB) echo "ESTABLISHED" ;;
        SYN-SENT) echo "SYN-SENT" ;;
        SYN-RECV) echo "SYN-RECV" ;;
        FIN-WAIT-1) echo "FIN-WAIT-1" ;;
        FIN-WAIT-2) echo "FIN-WAIT-2" ;;
        TIME-WAIT) echo "TIME-WAIT" ;;
        CLOSE-WAIT) echo "CLOSE-WAIT" ;;
        LAST-ACK) echo "LAST-ACK" ;;
        CLOSING) echo "CLOSING" ;;
        CLOSED) echo "CLOSED" ;;
        UNCONN) echo "UNCONN" ;;
        LISTEN) echo "LISTEN" ;;
        *) echo "$1" ;;
    esac
}

# 取某状态的连接数：state_count <"计数 状态"列表> <状态>
state_count() {
    printf '%s\n' "$1" | awk -v s="$2" '$2==s{n+=$1} END{print n+0}'
}

mode_name() {
    case "$1" in
        1) echo "1 GFWList" ;;
        2) echo "2 国内白名单" ;;
        3) echo "3 游戏模式" ;;
        4) echo "4 全局代理" ;;
        *) echo "$1" ;;
    esac
}

# 载入时长可读化
up_text() {
    [ -z "$UP_SEC" ] && {
        echo "未知"
        return
    }
    printf '%dh%02dm' "$((UP_SEC / 3600))" "$(((UP_SEC % 3600) / 60))"
}

# ---------- 客户端名称 / MAC ----------
# 1) DHCP 租约文件（dnsmasq: 过期时间 MAC IP 名称 客户端ID；busybox udhcpd: 过期时间 MAC IP 名称）
dhcp_name() {
    _ip="$1"
    for _f in $LEASE_FILES; do
        [ -r "$_f" ] || continue
        _n=$(awk -v ip="$_ip" '$3==ip && $4!="*" {print $4; exit}' "$_f" 2>/dev/null)
        if [ -n "$_n" ]; then
            printf '%s' "$_n"
            return 0
        fi
    done
    return 1
}

# 2) 反向 DNS（路由器 dnsmasq 通常能为 DHCP 客户端解析 PTR）
#    bind 输出 "Name:\t主机名"；其它实现可能输出 "name = 主机名."
ptr_name() {
    _ip="$1"
    _out=$(nslookup "$_ip" 2>/dev/null | sed -n -e 's/^.*name = //p' -e 's/^Name:[[:space:]]*//p' | head -n1)
    _out=$(printf '%s' "$_out" | sed -e 's/[[:space:]]*$//' -e 's/\.$//')
    case "$_out" in
        "" | "$_ip" | *in-addr.arpa*) return 1 ;;
    esac
    printf '%s' "$_out"
}

# 客户端名称：租约文件 → 反向 DNS → "-"
client_name() {
    _n=$(dhcp_name "$1") || _n=$(ptr_name "$1") || _n=""
    if [ -n "$_n" ]; then
        printf '%s' "$_n"
    else
        printf '%s' "-"
    fi
}

# MAC 地址：/proc/net/arp → arp -an → "-"
client_mac() {
    _ip="$1"
    _mac=""
    if [ -r "$PROC_ROOT/net/arp" ]; then
        _mac=$(awk -v ip="$_ip" '$1==ip && $4!="00:00:00:00:00:00" {print $4; exit}' "$PROC_ROOT/net/arp" 2>/dev/null)
    fi
    if [ -z "$_mac" ] && command -v arp >/dev/null 2>&1; then
        _mac=$(arp -an 2>/dev/null | awk -v ip="$_ip" 'index($0,"(" ip ")")>0 {for(i=1;i<=NF;i++) if($i ~ /^([0-9a-fA-F][0-9a-fA-F]:){5}[0-9a-fA-F][0-9a-fA-F]$/) {print $i; exit}}')
    fi
    if [ -n "$_mac" ]; then
        printf '%s' "$_mac"
    else
        printf '%s' "-"
    fi
}

# JSON 字符串转义
jstr() {
    printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# ---------- 采集 ----------
PID=""
if command -v pidof >/dev/null 2>&1; then
    PID=$(pidof "$PROC_NAME" 2>/dev/null | awk '{print $1}')
fi
[ -z "$PID" ] && PID=$(pgrep -x "$PROC_NAME" 2>/dev/null | head -n1)

NOW_TEXT=$(date '+%Y-%m-%d %H:%M:%S')

if [ -z "$PID" ]; then
    if [ "$JSON_MODE" = "1" ]; then
        printf '{"running":false,"time":%s,"proc":"%s"}\n' "$(jstr "$NOW_TEXT")" "$PROC_NAME"
        exit 0
    fi
    printf '════════════════ XWall 运行状态排查 ════════════════\n'
    printf '时间 %s\n' "$NOW_TEXT"
    printf '内核 未运行（进程 %s 不存在）\n' "$PROC_NAME"
    printf '\n── 建议 ────────────────────────────\n'
    printf '  · 启动：/data/softcenter/bin/xwall start\n'
    printf '  · 看日志：扩展 → 查看Xray运行日志\n'
    printf '═══════════════════════════════════════════════════\n'
    exit 0
fi

UP_SEC=""
if [ -r "$PROC_ROOT/uptime" ] && [ -r "$PROC_ROOT/$PID/stat" ]; then
    _now=$(awk '{print int($1)}' "$PROC_ROOT/uptime" 2>/dev/null)
    _st=$(awk '{print $22}' "$PROC_ROOT/$PID/stat" 2>/dev/null)
    _hz=$(getconf CLK_TCK 2>/dev/null)
    [ -z "$_hz" ] && _hz=100
    if [ -n "$_now" ] && [ -n "$_st" ]; then
        UP_SEC=$((_now - _st / _hz))
        [ "$UP_SEC" -lt 0 ] && UP_SEC=0
    fi
fi
MEM_KB=$(awk '/^VmRSS:/{print $2}' "$PROC_ROOT/$PID/status" 2>/dev/null)
MEM_TEXT="未知"
[ -n "$MEM_KB" ] && MEM_TEXT="$((MEM_KB / 1024)).$((MEM_KB % 1024 * 10 / 1024)) MB"
HIJACK_TEXT=$([ "$DNS_HIJACK" = "1" ] && echo 开 || echo 关)
SOCKS_TEXT=$([ "$XWALL_SOCKS_ENABLE" = "1" ] && echo 开 || echo 关)
MODE_TEXT=$(mode_name "$PROXY_MODE")

# 连接
SS_ALL=""
SS_TCP=""
HAS_SS=0
if command -v ss >/dev/null 2>&1; then
    HAS_SS=1
    SS_ALL=$(ss -anp 2>/dev/null | grep -- "$PROC_NAME")
    SS_TCP=$(ss -antp 2>/dev/null | grep -- "$PROC_NAME")
fi
TOTAL=0
[ -n "$SS_ALL" ] && TOTAL=$(printf '%s\n' "$SS_ALL" | grep -c .)
PROTO_TCP=0
PROTO_UDP=0
PROTO_OTHER=0
if [ -n "$SS_ALL" ]; then
    PROTO_TCP=$(printf '%s\n' "$SS_ALL" | awk '$1 ~ /^tcp/ {n++} END{print n+0}')
    PROTO_UDP=$(printf '%s\n' "$SS_ALL" | awk '$1 ~ /^udp/ {n++} END{print n+0}')
    PROTO_OTHER=$((TOTAL - PROTO_TCP - PROTO_UDP))
    [ "$PROTO_OTHER" -lt 0 ] && PROTO_OTHER=0
fi
PROTO_LIST=$(printf '%s\n' "$SS_ALL" | awk 'NF{print $1}' | sort | uniq -c | sort -nr)

FD_COUNT=""
FD_MAX=""
[ -d "$PROC_ROOT/$PID/fd" ] && FD_COUNT=$(ls "$PROC_ROOT/$PID/fd" 2>/dev/null | wc -l | tr -d ' ')
FD_MAX=$(awk '/Max open files/{print $4}' "$PROC_ROOT/$PID/limits" 2>/dev/null)
FD_PCT=0
if [ -n "$FD_COUNT" ] && [ -n "$FD_MAX" ] && [ "$FD_MAX" -gt 0 ] 2>/dev/null; then
    FD_PCT=$((FD_COUNT * 100 / FD_MAX))
fi

# TCP 状态
TCP_STATES=""
[ -n "$SS_TCP" ] && TCP_STATES=$(printf '%s\n' "$SS_TCP" | awk 'NF{print $1}' | sort | uniq -c | sort -nr)
SYN_SENT=0
SYN_RECV=0
CLOSE_WAIT=0
LAST_ACK=0
FIN_WAIT=0
TIME_WAIT=0
ESTAB=0
if [ -n "$TCP_STATES" ]; then
    SYN_SENT=$(state_count "$TCP_STATES" SYN-SENT)
    SYN_RECV=$(state_count "$TCP_STATES" SYN-RECV)
    CLOSE_WAIT=$(state_count "$TCP_STATES" CLOSE-WAIT)
    LAST_ACK=$(state_count "$TCP_STATES" LAST-ACK)
    TIME_WAIT=$(state_count "$TCP_STATES" TIME-WAIT)
    ESTAB=$(state_count "$TCP_STATES" ESTAB)
    FIN_WAIT=$(( $(state_count "$TCP_STATES" FIN-WAIT-1) + $(state_count "$TCP_STATES" FIN-WAIT-2) ))
fi
TCP_TOTAL="$PROTO_TCP"
if [ "$TCP_TOTAL" -eq 0 ]; then
    TCP_TOTAL=$(printf '%s\n' "$TCP_STATES" | awk '{n+=$1} END{print n+0}')
fi
PEND=$((SYN_SENT + SYN_RECV))
STUCK=$((CLOSE_WAIT + LAST_ACK + FIN_WAIT))

# 端口
NET_ALL=""
HAS_NETSTAT=0
if command -v netstat >/dev/null 2>&1; then
    HAS_NETSTAT=1
    NET_ALL=$(netstat -anp 2>/dev/null | grep -- "$PROC_NAME" | grep -E '^(tcp|udp)')
fi
REMOTE_TOP=""
LOCAL_TOP=""
if [ -n "$NET_ALL" ]; then
    REMOTE_TOP=$(printf '%s\n' "$NET_ALL" | awk '{print $5}' | awk -F: '{print $NF}' | grep -E '^[0-9]+$' | sort -n | uniq -c | sort -nr | head -n 10)
    LOCAL_TOP=$(printf '%s\n' "$NET_ALL" | awk '{print $4}' | awk -F: '{print $NF}' | grep -E '^[0-9]+$' | sort -n | uniq -c | sort -nr | head -n 5)
fi
REMOTE_MAX=$(printf '%s\n' "$REMOTE_TOP" | awk 'NR==1{print $1}')
LOCAL_MAX=$(printf '%s\n' "$LOCAL_TOP" | awk 'NR==1{print $1}')

# 局域网设备（conntrack UDP）
CT_COUNT=""
CT_MAX=""
LAN_TOP=""
if command -v conntrack >/dev/null 2>&1; then
    LAN_TOP=$(conntrack -L -p udp 2>/dev/null | awk '{print $4}' | grep -E '^src=(192\.168\.|10\.|172\.)' | sed 's/^src=//' | sort | uniq -c | sort -nr | head -n 10)
fi
[ -r "$PROC_ROOT/sys/net/netfilter/nf_conntrack_count" ] && CT_COUNT=$(cat "$PROC_ROOT/sys/net/netfilter/nf_conntrack_count" 2>/dev/null)
[ -r "$PROC_ROOT/sys/net/netfilter/nf_conntrack_max" ] && CT_MAX=$(cat "$PROC_ROOT/sys/net/netfilter/nf_conntrack_max" 2>/dev/null)
LAN_MAX=$(printf '%s\n' "$LAN_TOP" | awk 'NR==1{print $1}')
CT_PCT=0
if [ -n "$CT_COUNT" ] && [ -n "$CT_MAX" ] && [ "$CT_MAX" -gt 0 ] 2>/dev/null; then
    CT_PCT=$((CT_COUNT * 100 / CT_MAX))
fi

# 规则与白名单
R_NAT="缺失"
R_MANGLE="缺失"
R_JUMP="缺失"
R_ROUTE="缺失"
R_SET="缺失"
R_SET_N=""
iptables -t nat -S "$CHAIN" >/dev/null 2>&1 && R_NAT="就位"
iptables -t mangle -S "$CHAIN" >/dev/null 2>&1 && R_MANGLE="就位"
if iptables -t nat -S PREROUTING 2>/dev/null | grep -q -- "-j $CHAIN" && iptables -t mangle -S PREROUTING 2>/dev/null | grep -q -- "-j $CHAIN"; then
    R_JUMP="就位"
fi
ip rule show 2>/dev/null | grep -q "lookup $ROUTE_TABLE" && R_ROUTE="就位"
if command -v ipset >/dev/null 2>&1; then
    if ipset list "$IPSET_BYPASS" >/dev/null 2>&1; then
        R_SET="就位"
        R_SET_N=$(ipset list "$IPSET_BYPASS" 2>/dev/null | awk '/Number of entries/{print $4}')
    fi
fi

# 结论条目（level: ok / warn / info）
VERDICTS=""
add_verdict() {
    if [ -n "$VERDICTS" ]; then
        VERDICTS="$VERDICTS
$1|$2"
    else
        VERDICTS="$1|$2"
    fi
}
if [ "$R_NAT" != "就位" ] || [ "$R_MANGLE" != "就位" ] || [ "$R_JUMP" != "就位" ] || [ "$R_ROUTE" != "就位" ]; then
    add_verdict warn "劫持规则不完整：流量可能没被接管（重启插件：/data/softcenter/bin/xwall restart）"
fi
if [ "$FD_PCT" -ge 70 ]; then
    add_verdict warn "文件描述符已用 ${FD_PCT}%，接近上限，注意连接数是否异常增长"
fi
if [ "$CT_PCT" -ge 80 ]; then
    add_verdict warn "conntrack 表已用 ${CT_PCT}%，再增长会丢弃新连接"
fi
if [ "$PEND" -gt 20 ]; then
    add_verdict warn "半开连接 ${PEND} 条（SYN-SENT ${SYN_SENT} / SYN-RECV ${SYN_RECV}）：上游可能不通或被阻断"
elif [ "$STUCK" -gt 100 ]; then
    add_verdict warn "待关闭连接 ${STUCK} 条（CLOSE-WAIT ${CLOSE_WAIT} / FIN-WAIT ${FIN_WAIT} / LAST-ACK ${LAST_ACK}）：对端未正常收尾，留意假死"
fi
if [ "$TOTAL" -eq 0 ]; then
    add_verdict info "当前没有连接：可能刚启动或局域网暂时没有流量"
fi
if [ "$PROTO_UDP" -gt 0 ] && [ "$TOTAL" -gt 0 ] && [ $((PROTO_UDP * 100 / TOTAL)) -ge 60 ]; then
    add_verdict info "UDP 占比偏高（QUIC / DNS 会话较多），属正常现象；主要看 fd 与 conntrack 是否宽裕"
fi
case "$VERDICTS" in
*warn*) ;;
*) add_verdict ok "未见异常：连接规模 ${TOTAL}（TCP ${PROTO_TCP} / UDP ${PROTO_UDP}），状态分布与规则均正常" ;;
esac

# ---------- JSON 输出 ----------
if [ "$JSON_MODE" = "1" ]; then
    proto_json() {
        _sep=""
        printf '%s\n' "$PROTO_LIST" | while read -r cnt name; do
            [ -z "$name" ] && continue
            printf '%s{"name":"%s","count":%s,"pct":"%s"}' "$_sep" "$name" "$cnt" "$(pctnum "$cnt" "$TOTAL")"
            _sep=","
        done
    }
    states_json() {
        _sep=""
        printf '%s\n' "$TCP_STATES" | while read -r cnt st; do
            [ -z "$st" ] && continue
            printf '%s{"short":"%s","name":"%s","count":%s,"pct":"%s"}' "$_sep" "$st" "$(state_name "$st")" "$cnt" "$(pctnum "$cnt" "$TCP_TOTAL")"
            _sep=","
        done
    }
    ports_json() {
        # $1=列表 $2=最大值
        _sep=""
        printf '%s\n' "$1" | while read -r cnt port; do
            [ -z "$port" ] && continue
            printf '%s{"port":"%s","service":"%s","count":%s,"pct":"%s"}' "$_sep" "$port" "$(port_name "$port")" "$cnt" "$(pctnum "$cnt" "$TOTAL")"
            _sep=","
        done
    }
    lan_json() {
        _sep=""
        printf '%s\n' "$LAN_TOP" | while read -r cnt ip; do
            [ -z "$ip" ] && continue
            _name=$(client_name "$ip")
            _mac=$(client_mac "$ip")
            printf '%s{"ip":"%s","name":%s,"mac":"%s","count":%s,"pct":"%s"}' \
                "$_sep" "$ip" "$(jstr "$_name")" "$_mac" "$cnt" "$(pctnum "$cnt" "$LAN_MAX")"
            _sep=","
        done
    }
    verdict_json() {
        _sep=""
        printf '%s\n' "$VERDICTS" | while IFS= read -r line; do
            [ -z "$line" ] && continue
            _lvl=${line%%|*}
            _txt=${line#*|}
            printf '%s{"level":"%s","text":%s}' "$_sep" "$_lvl" "$(jstr "$_txt")"
            _sep=","
        done
    }
    printf '{'
    printf '"time":%s,' "$(jstr "$NOW_TEXT")"
    printf '"running":true,'
    printf '"pid":"%s",' "$PID"
    printf '"uptime":"%s",' "$(up_text)"
    printf '"mem":"%s",' "$MEM_TEXT"
    printf '"mode":"%s",' "$MODE_TEXT"
    printf '"hijack":"%s",' "$HIJACK_TEXT"
    printf '"socks":"%s",' "$SOCKS_TEXT"
    printf '"dns_cn":"%s","dns_foreign":"%s","loglevel":"%s",' "$DNS_CN" "$DNS_FOREIGN" "$XRAY_LOG_LEVEL"
    printf '"total":%s,"tcp":%s,"udp":%s,"other":%s,' "$TOTAL" "$PROTO_TCP" "$PROTO_UDP" "$PROTO_OTHER"
    printf '"fd":{"count":"%s","max":"%s","pct":%s},' "$FD_COUNT" "$FD_MAX" "$FD_PCT"
    printf '"proto":[%s],' "$(proto_json)"
    printf '"states":[%s],' "$(states_json)"
    printf '"remote_ports":[%s],' "$(ports_json "$REMOTE_TOP")"
    printf '"local_ports":[%s],' "$(ports_json "$LOCAL_TOP")"
    printf '"lan":[%s],' "$(lan_json)"
    printf '"conntrack":{"count":"%s","max":"%s","pct":%s},' "$CT_COUNT" "$CT_MAX" "$CT_PCT"
    printf '"rules":{"nat":"%s","mangle":"%s","jump":"%s","route":"%s","ipset":"%s","ipset_n":"%s"},' \
        "$R_NAT" "$R_MANGLE" "$R_JUMP" "$R_ROUTE" "$R_SET" "$R_SET_N"
    printf '"verdicts":[%s]' "$(verdict_json)"
    printf '}\n'
    exit 0
fi

# ---------- 文本报告 ----------
printf '════════════════ XWall 运行状态排查 ════════════════\n'
printf '时间 %s\n' "$NOW_TEXT"
printf '内核 PID %s   运行 %s   内存 %s\n' "$PID" "$(up_text)" "$MEM_TEXT"
printf '代理 模式 %s   域名劫持 %s   SOCKS5 %s\n' "$MODE_TEXT" "$HIJACK_TEXT" "$SOCKS_TEXT"
printf 'DNS  国内 %s   国外 %s   日志级别 %s\n' "$DNS_CN" "$DNS_FOREIGN" "$XRAY_LOG_LEVEL"

section "1. 连接总览"
if [ "$HAS_SS" = "0" ]; then
    printf '  ss 命令缺失，无法统计连接（请检查系统）\n'
else
    printf '  总连接数        %6s\n' "$TOTAL"
    printf '  TCP            %6s  %s  %6s\n' "$PROTO_TCP" "$(bar "$PROTO_TCP" "$TOTAL")" "$(pct "$PROTO_TCP" "$TOTAL")"
    printf '  UDP            %6s  %s  %6s\n' "$PROTO_UDP" "$(bar "$PROTO_UDP" "$TOTAL")" "$(pct "$PROTO_UDP" "$TOTAL")"
    if [ "$PROTO_OTHER" -gt 0 ]; then
        printf '  其它           %6s  %s  %6s\n' "$PROTO_OTHER" "$(bar "$PROTO_OTHER" "$TOTAL")" "$(pct "$PROTO_OTHER" "$TOTAL")"
    fi
fi
if [ -n "$FD_COUNT" ]; then
    printf '  文件描述符     %6s  %s  %6s' "$FD_COUNT" "$(bar "$FD_COUNT" "${FD_MAX:-$FD_COUNT}" 18)" "$(pct "$FD_COUNT" "${FD_MAX:-$FD_COUNT}")"
    [ -n "$FD_MAX" ] && printf '  / %s' "$FD_MAX"
    printf '\n'
fi

section "2. 协议占比（tcp / udp 分别统计）"
if [ -n "$PROTO_LIST" ]; then
    printf '%s\n' "$PROTO_LIST" | while read -r cnt proto; do
        [ -z "$proto" ] && continue
        if [ "$TOTAL" -gt 0 ]; then
            printf '  %-8s %6s  %s  %6s\n' "$proto" "$cnt" "$(bar "$cnt" "$TOTAL")" "$(pctnum "$cnt" "$TOTAL")"
        else
            printf '  %-8s %6s\n' "$proto" "$cnt"
        fi
    done
else
    printf '  无连接\n'
fi

section "3. TCP 状态分布（排查假死 / 堵塞）"
if [ -n "$TCP_STATES" ]; then
    printf '%s\n' "$TCP_STATES" | while read -r cnt st; do
        [ -z "$st" ] && continue
        if [ "$TCP_TOTAL" -gt 0 ]; then
            printf '  %-12s %6s  %s  %6s\n' "$(state_name "$st")" "$cnt" "$(bar "$cnt" "$TCP_TOTAL")" "$(pctnum "$cnt" "$TCP_TOTAL")"
        else
            printf '  %-12s %6s\n' "$(state_name "$st")" "$cnt"
        fi
    done
else
    printf '  无 TCP 连接\n'
fi
if [ "$PEND" -gt 20 ]; then
    printf '  ! 半开连接 %s 条（SYN-SENT %s / SYN-RECV %s）：上游可能不通或被阻断\n' "$PEND" "$SYN_SENT" "$SYN_RECV"
elif [ "$STUCK" -gt 100 ]; then
    printf '  ! 待关闭连接 %s 条（CLOSE-WAIT %s / FIN-WAIT %s / LAST-ACK %s）：对端未正常收尾，留意假死\n' \
        "$STUCK" "$CLOSE_WAIT" "$FIN_WAIT" "$LAST_ACK"
elif [ "$TCP_TOTAL" -gt 0 ]; then
    printf '  ✓ 状态分布正常（ESTABLISHED %s / TIME-WAIT %s）\n' "$ESTAB" "$TIME_WAIT"
fi

section "4. 端口分布"
if [ "$HAS_NETSTAT" = "0" ]; then
    printf '  netstat 命令缺失，无法统计端口\n'
elif [ -z "$NET_ALL" ]; then
    printf '  无连接\n'
else
    printf '  远端目标端口 Top10\n'
    printf '%s\n' "$REMOTE_TOP" | while read -r cnt port; do
        [ -z "$port" ] && continue
        printf '    %-6s %-10s %5s  %s  %6s\n' "$port" "$(port_name "$port")" "$cnt" \
            "$(bar "$cnt" "${REMOTE_MAX:-1}" 16)" "$(pctnum "$cnt" "$TOTAL")"
    done
    printf '  本地端口 Top5\n'
    printf '%s\n' "$LOCAL_TOP" | while read -r cnt port; do
        [ -z "$port" ] && continue
        printf '    %-6s %-10s %5s  %s  %6s\n' "$port" "$(port_name "$port")" "$cnt" \
            "$(bar "$cnt" "${LOCAL_MAX:-1}" 16)" "$(pctnum "$cnt" "$TOTAL")"
    done
fi

section "5. 局域网设备占用 Top10（conntrack UDP，含客户端名称与 MAC）"
if [ -n "$LAN_TOP" ]; then
    printf '  %-15s %-16s %5s  %7s  %s\n' "IP" "NAME" "CNT" "PCT" "MAC"
    printf '%s\n' "$LAN_TOP" | while read -r cnt ip; do
        [ -z "$ip" ] && continue
        _name=$(client_name "$ip")
        _mac=$(client_mac "$ip")
        _short=$(printf '%s' "$_name" | cut -c1-16)
        _macshort=$(printf '%s' "$_mac" | cut -d: -f1-3)
        printf '  %-15s %-16s %5s  %7s  %s\n' "$ip" "$_short" "$cnt" "$(pctnum "$cnt" "$LAN_MAX")" "$_macshort"
    done
else
    printf '  无 UDP 会话记录（或 conntrack 命令不可用）\n'
fi
if [ -n "$CT_COUNT" ] && [ -n "$CT_MAX" ]; then
    printf '  conntrack 表 %s / %s  %s  %s\n' "$CT_COUNT" "$CT_MAX" "$(bar "$CT_COUNT" "$CT_MAX" 18)" "$(pct "$CT_COUNT" "$CT_MAX")"
fi

section "6. 劫持规则与白名单（只读检查）"
printf '  nat/mangle 链  nat %s / mangle %s\n' "$R_NAT" "$R_MANGLE"
printf '  PREROUTING 跳转 %s\n' "$R_JUMP"
printf '  策略路由 table %s %s\n' "$ROUTE_TABLE" "$R_ROUTE"
printf '  直连白名单 %s %s' "$R_SET" "$([ -n "$R_SET_N" ] && echo "($R_SET_N 条)")"
printf '\n'

section "7. 结论"
printf '%s\n' "$VERDICTS" | while IFS= read -r line; do
    [ -z "$line" ] && continue
    _lvl=${line%%|*}
    _txt=${line#*|}
    case "$_lvl" in
        warn) printf '  ! %s\n' "$_txt" ;;
        ok) printf '  ✓ %s\n' "$_txt" ;;
        *) printf '  · %s\n' "$_txt" ;;
    esac
done
printf '═══════════════════════════════════════════════════\n'
exit 0
