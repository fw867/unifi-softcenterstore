#!/bin/sh

# UniFi SoftCenter · FakeSIP (UDP 协议伪装为 SIP)
# 面板配置：/data/softcenter/config/fakesip.env
# 二进制：/data/softcenter/bin/fakesip-core（缺则由 fakesip-dl 下载）
# 文档：https://github.com/MikeWang000000/FakeSIP/wiki

if [ "$1" = "status" ]; then
    if pgrep -x fakesip-core >/dev/null 2>&1; then
        echo "running"
        exit 0
    fi
    echo "stopped"
    exit 1
fi

CONFIG="/data/softcenter/config/fakesip.env"
[ -f "$CONFIG" ] && . "$CONFIG"

BIN="/data/softcenter/bin/fakesip-core"
DL="/data/softcenter/bin/fakesip-dl"
LOG="${FAKESIP_LOG:-/var/log/fakesip.log}"

# 网卡：空则 -a 全部接口
IFACE="${FAKESIP_IFACE:-}"
# 自定义 SIP URI（可选，对应 -u）
SIP_URI="${FAKESIP_URI:-}"
# 使用 iptables 而不是 nft
USE_IPTABLES="${FAKESIP_USE_IPTABLES:-0}"
# 静默模式（不记录 IP）
SILENT="${FAKESIP_SILENT:-0}"
# 调试日志：1 时 fakesip -w 写入插件日志；0 时不写核心日志
DEBUG="${FAKESIP_DEBUG:-0}"
# 动态 TTL：开启后将 TTL 提升至估算跃点数的 TTL_PCT%（对应 -y）
DYN_TTL="${FAKESIP_DYN_TTL:-0}"
TTL_PCT="${FAKESIP_TTL_PCT:-50}"

log_date() {
    local line="【$(date '+%Y年%m月%d日 %H:%M:%S')】: $1"
    echo "$line"
    echo "$line" >> "$LOG"
}

ensure_bin() {
    if [ -f "$BIN" ] && [ -x "$BIN" ]; then
        magic=$(dd if="$BIN" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
        [ "$magic" = "7f454c46" ] && return 0
        log_date "$BIN 不是有效 ELF，强制重新下载"
        FORCE_DOWNLOAD=1
    fi
    if [ -x "$DL" ]; then
        SSUP_NO_START=1 FORCE_DOWNLOAD="${FORCE_DOWNLOAD:-1}" "$DL"
    else
        log_date "未找到下载脚本 $DL"
        return 1
    fi
    [ -x "$BIN" ] || return 1
}

is_running() {
    pgrep -x fakesip-core >/dev/null 2>&1
}

# 自动探测 WAN：优先 ppp0，其次 PPPoE 物理口 / 默认路由
detect_wan_iface() {
    local iface=""
    if [ -d /sys/class/net/ppp0 ]; then
        iface="ppp0"
    fi
    if [ -z "$iface" ] && [ -f /etc/ppp/peers/ppp0 ]; then
        iface=$(sed -n 's/^plugin[[:space:]].*[[:space:]]\([^[:space:]]*\)[[:space:]]*$/\1/p' /etc/ppp/peers/ppp0 | head -n1)
    fi
    if [ -z "$iface" ]; then
        iface=$(ip -4 route show default 2>/dev/null | sed -n 's/.*dev \([^[:space:]]*\).*/\1/p' | head -n1)
    fi
    printf '%s' "$iface"
}

start_fakesip() {
    ensure_bin || { log_date "FakeSIP 二进制不可用"; exit 1; }
    if is_running; then
        echo "fakesip 已在运行"
        return 0
    fi

    if [ -n "$IFACE" ]; then
        ARGS="-i \"$IFACE\""
        log_date "使用配置网卡: $IFACE"
    else
        WAN_IF=$(detect_wan_iface)
        if [ -n "$WAN_IF" ]; then
            ARGS="-i \"$WAN_IF\""
            log_date "自动探测 WAN 网卡: $WAN_IF"
        else
            ARGS="-a"
            log_date "未能探测 WAN 网卡，作用于全部接口 (-a)"
        fi
    fi
    [ -n "$SIP_URI" ] && ARGS="$ARGS -u \"$SIP_URI\""
    [ "$USE_IPTABLES" = "1" ] && ARGS="$ARGS -z"
    [ "$SILENT" = "1" ] && ARGS="$ARGS -s"
    if [ "$DYN_TTL" = "1" ]; then
        case "$TTL_PCT" in
            ''|*[!0-9]*) TTL_PCT=100 ;;
        esac
        ARGS="$ARGS -y $TTL_PCT"
        log_date "动态 TTL 已开启，提升至估算跃点数的 ${TTL_PCT}%"
    fi
    if [ "$DEBUG" = "1" ]; then
        # 开启调试：核心运行日志写入插件日志（LogPath）
        mkdir -p "$(dirname "$LOG")"
        touch "$LOG" 2>/dev/null
        ARGS="$ARGS -w \"$LOG\""
        log_date "调试日志已开启 → $LOG"
    fi

    # 默认 -d 守护进程运行（官方推荐）
    ARGS="-d $ARGS"
    log_date "启动 FakeSIP ARGS=$ARGS"
    eval "\"$BIN\" $ARGS"
    sleep 1
    if is_running; then
        log_date "FakeSIP 启动成功 PID=$(pgrep -x fakesip-core | head -n 1)"
        echo "FakeSIP 已启动"
    else
        log_date "FakeSIP 启动失败，详见 $LOG"
        echo "启动失败，请查看 $LOG"
        tail -n 20 "$LOG" 2>/dev/null
        exit 1
    fi
}

stop_fakesip() {
    if is_running; then
        [ -x "$BIN" ] && "$BIN" -k 2>/dev/null
        sleep 1
        pkill -x fakesip-core 2>/dev/null
        sleep 1
        pkill -9 -x fakesip-core 2>/dev/null
        log_date "FakeSIP 已停止"
        echo "FakeSIP 已停止"
    else
        [ -x "$BIN" ] && "$BIN" -k 2>/dev/null
        echo "FakeSIP 未在运行"
    fi
}

case "${1}" in
start)
    start_fakesip
    ;;
stop)
    stop_fakesip
    ;;
restart)
    stop_fakesip
    sleep 1
    start_fakesip
    ;;
status)
    exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
