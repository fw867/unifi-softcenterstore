    mkdir -p /run/dnsmasq.dhcp.conf.d
    
    if [ ! -f "/run/dnsmasq.dhcp.conf.d/koolroute.conf" ]; then
        log_date "创建状态检测解析优化配置文件"
        cat > /run/dnsmasq.dhcp.conf.d/koolroute.conf <<-EOF
server=/.google.com.tw/127.0.0.1#7913
ipset=/.google.com.tw/router
server=/.google.com.ncr/127.0.0.1#7913
ipset=/.google.com.ncr/router
server=/.github.com/127.0.0.1#7913
ipset=/.github.com/router
server=/.github.io/127.0.0.1#7913
ipset=/.github.io/router
server=/.raw.githubusercontent.com/127.0.0.1#7913
ipset=/.raw.githubusercontent.com/router
server=/.apnic.net/127.0.0.1#7913
ipset=/.apnic.net/router
server=/.s3.amazonaws.com/127.0.0.1#7913
ipset=/.s3.amazonaws.com/router
server=/.openwrt.org/127.0.0.1#7913
ipset=/.openwrt.org/router
EOF
    fi

    [ ! -f /run/dnsmasq.dhcp.conf.d/koolgfwlist.conf ] && ln -sf /data/softcenter/bin/koolssrule/gfwlist.conf /run/dnsmasq.dhcp.conf.d/koolgfwlist.conf

    rm -f /run/dnsmasq.dhcp.conf.d/koolwblist.conf

    # 域名白名单：走运营商 DNS + ipset white_list
    if [ -n "$WHITE_DOMAIN_LIST" ]; then
        write_domain_file "$WHITE_DOMAIN_LIST" /tmp/koolss_whitedomain.txt
        if [ -s /tmp/koolss_whitedomain.txt ]; then
            echo "#for white_domain" >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            awk -v dns="${ISP_DNS1}" '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "server=/." $0 "/" dns }' /tmp/koolss_whitedomain.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            awk '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "ipset=/." $0 "/white_list" }' /tmp/koolss_whitedomain.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            log_date "已加载域名白名单 $(wc -l < /tmp/koolss_whitedomain.txt) 条"
        fi
        rm -f /tmp/koolss_whitedomain.txt
    fi

    # 域名黑名单：走本地防污染 DNS + ipset black_list
    if [ -n "$BLACK_DOMAIN_LIST" ]; then
        write_domain_file "$BLACK_DOMAIN_LIST" /tmp/koolss_blackdomain.txt
        if [ -s /tmp/koolss_blackdomain.txt ]; then
            echo "#for black_domain" >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            awk '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "server=/." $0 "/127.0.0.1#7913" }' /tmp/koolss_blackdomain.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            awk '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "ipset=/." $0 "/black_list" }' /tmp/koolss_blackdomain.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
            log_date "已加载域名黑名单 $(wc -l < /tmp/koolss_blackdomain.txt) 条"
        fi
        rm -f /tmp/koolss_blackdomain.txt
    fi

    if [ "$v2ray_udp_list" = "1" ] && [ -s "/data/softcenter/bin/koolssrule/udplist.txt" ]; then
        echo "#for udp_list" >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
        awk '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "server=/." $0 "/127.0.0.1#7913" }' /data/softcenter/bin/koolssrule/udplist.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
        awk '{ sub(/\r$/, ""); if ($0 != "" && $0 !~ /^#/) print "ipset=/." $0 "/udp_list" }' /data/softcenter/bin/koolssrule/udplist.txt >> /run/dnsmasq.dhcp.conf.d/koolwblist.conf
    fi

    killall dnsmasq 2>/dev/null
}

dns_origin() {
    rm -f /run/dnsmasq.dhcp.conf.d/kool*.conf
}

dnsfwd_flush() {
    log_date "正在刷新 dnsmasq 缓存..."
    killall -HUP dnsmasq 2>/dev/null
    log_date "DNS 缓存刷新完毕"
}

current_ip() {
    local ip_info=$(curl -4skL ip.chinaz.com/getip.aspx | sed -r "s/^\{ip:'(.*)',address:'(.*)'\}$/\1|\2/g")
    local my_ip=$(echo "$ip_info" | awk -F'|' '{print $1}')
    local my_loc=$(echo "$ip_info" | awk -F'|' '{print $2}')
    echo -e "\e[37mIP:\e[0m ${my_ip}\t\e[37m位置:\e[0m ${my_loc}"
}

start_v2ray(){
    if [ ! -x "$XRAY_BIN" ]; then
        log_date "未找到 $XRAY_BIN，调用 ssup 下载最新 Xray..."
        SSUP_NO_START=1 /data/softcenter/bin/ssup
        if [ ! -x "$XRAY_BIN" ]; then
            log_date "ssup 下载 Xray 失败，无法启动"
            return 1
        fi
    fi
    log_date "开启 Xray 主进程..."
    "$XRAY_BIN" run -c "$XRAY_JSON_PATH" >/dev/null 2>&1 &
    
    local i=10
    while [ $i -gt 0 ]; do
        V2PID=$(pidof xray)
        if [ -n "$V2PID" ]; then
            log_date "v2ray 启动成功，PID：$V2PID"
            return
        fi
        sleep 1
        i=$((i - 1))
    done
    log_date "Xray 进程启动失败！"
}

kill_process() {
    log_date "正在关闭进程..."
    killall xray 2>/dev/null
    sleep 1
    killall -9 xray 2>/dev/null
}

clean_log() {
    rm -f /tmp/xray*.log /tmp/xray.json /tmp/koolss_whitedomain.txt /tmp/koolss_blackdomain.txt
}

restart_process() {
    kill_process
    sleep 1
    prepare_config
    start_v2ray
    if pgrep -x xray > /dev/null; then echo "running"; else echo "stopped"; fi
}

start() {
    set_lock
    prepare_config
    check_and_clean_logs
    check_dns
    dns_origin
    ipfwd_on
    start_v2ray
    create_ipsetlist
    add_white_black_ip
    ipts_update
    dns_update
    chromecast
    unset_lock
}

stop() {
    set_lock
    kill_process
    ipts_origin
    dns_origin
    clean_log
    killall dnsmasq 2>/dev/null
    unset_lock
}

restart() {
    set_lock
    kill_process
    ipts_origin
    dns_origin
    clean_log
    check_dns
    dns_origin
    prepare_config
    ipfwd_on
    start_v2ray
    create_ipsetlist
    add_white_black_ip
    ipts_update
    dns_update
    chromecast
    unset_lock
}

usage() {
    echo -e "\e[37mUsage:\e[0m \e[36m${0}\e[0m \e[1;37mCOMMAND\e[0m"
    echo -e "\e[1;37mCOMMAND\e[0m := {"
    echo -e "\t\e[33mstart\e[0m\t\t启动透明代理"
    echo -e "\t\e[33mstop\e[0m\t\t停止透明代理"
    echo -e "\t\e[33mrestart\e[0m\t\t重启透明代理"
    echo -e "\t\e[33mstatus\e[0m\t\t查看运行状态"
    echo -e "\t\e[33mip\e[0m\t\t显示当前出口IP"
    echo -e "\t\e[33mupdate\e[0m\t\t更新 IPSet 列表"
    echo -e "\t\e[33mflush\e[0m\t\t刷新 DNS 缓存"
    echo -e "}"
}

case ${1} in
    start) start ;;
    status) exit 1 ;;
    stop) stop ;;
    restart) restart ;;
    ip) current_ip ;;
    update) create_ipsetlist ;;
    process) restart_process ;;
    flush) dnsfwd_flush ;;
    help|*) usage; exit 1 ;;
esac