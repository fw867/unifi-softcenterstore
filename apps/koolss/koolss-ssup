#!/bin/sh

# UDM 适配版的 Xray 一键更新脚本 (GitHub 官方源 + SOCKS5 代理支持)
# 无本地 xray 时直接下载最新版，不做版本比较
# SSUP_NO_START=1 时只安装不拉起 koolss（供 koolss 启动时调用）

alias echo_date='echo 【$(date "+%Y年%m月%d日 %H:%M:%S")】:'

XRAY_CONFIG_FILE="/tmp/xray.json"
XRAY_BIN="/data/softcenter/bin/koolss-xray"
SSUP_BIN="/data/softcenter/bin/koolss-ssup"
GITHUB_API="https://api.github.com/repos/XTLS/Xray-core/releases/latest"
FORCE_DOWNLOAD="${FORCE_DOWNLOAD:-0}"
SSUP_NO_START="${SSUP_NO_START:-0}"

# 代理：读软件中心「系统设置 → 全局更新代理」(/data/softcenter/config.json 的 LocalProxy)
SC_PROXY=$(sed -n 's/.*"LocalProxy"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /data/softcenter/config.json 2>/dev/null | head -n1)
CURL_OPT=""
if [ -n "$SC_PROXY" ]; then
    CURL_OPT="-x $SC_PROXY"
    echo_date "升级代理（全局更新代理）: $SC_PROXY"
else
    echo_date "未配置全局更新代理，直连 GitHub"
fi

# 1. 自动获取 UDM 架构
arch=$(uname -m)
case $arch in
    aarch64|arm64)
        ZIP_NAME="Xray-linux-arm64-v8a.zip"
        ;;
    x86_64|amd64)
        ZIP_NAME="Xray-linux-64.zip"
        ;;
    *)
        echo_date "暂不支持的路由器架构: $arch"
        exit 1
        ;;
esac

# 版本号必须是 数字.数字(.数字...) ，否则视为检测失败
is_valid_version() {
    echo "$1" | grep -Eq '^[0-9]+(\.[0-9]+)+$'
}

get_latest_version(){
    if [ ! -x "${XRAY_BIN}" ]; then
        echo_date "本地未找到 ${XRAY_BIN}，直接下载最新版..."
        FORCE_DOWNLOAD=1
    fi

    echo_date "检测线上 XTLS/Xray-core 最新版本..."

    # -f：HTTP 4xx/5xx 视为失败，避免错误页被当成版本信息继续下载
    LATEST_INFO=$(curl $CURL_OPT --connect-timeout 10 --max-time 30 -fsSL "$GITHUB_API")
    CURL_RC=$?
    if [ "$CURL_RC" != "0" ] || [ -z "$LATEST_INFO" ]; then
        echo_date "获取 Xray 最新版本信息失败 (curl exit=${CURL_RC})！请检查网络或代理连通性，已中止，不会继续下载。"
        exit 1
    fi

    # GitHub API 为单行 JSON，须精确匹配 tag_name，不能用贪婪的 .*"([^"]+)".*
    # 兼容 "tag_name":"v26.3.27" 与 "tag_name": "v26.3.27"
    XVERSION=$(printf '%s\n' "$LATEST_INFO" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v?([^"]+)".*/\1/p' | head -n1)
    XVERSION=$(printf '%s' "$XVERSION" | tr -d '\r\n ')

    if ! is_valid_version "$XVERSION"; then
        echo_date "解析版本号失败（得到：${XVERSION:-空}）！可能触发了 GitHub API 频率限制，已中止，不会继续下载。"
        echo "API 返回如下内容："
        echo "$LATEST_INFO" | head -n 5
        exit 1
    fi

    echo_date "检测到线上最新版本：v${XVERSION}"

    if [ -f "${XRAY_BIN}" ] && [ "$FORCE_DOWNLOAD" != "1" ]; then
        CUR_VER=$($XRAY_BIN version 2>/dev/null | head -n 1 | awk '{print $2}' | sed 's/v//g; s/\r//g; s/ //g')
        [ -z "$CUR_VER" ] && CUR_VER="0"
        if [ "$CUR_VER" != "0" ]; then
            echo_date "当前已安装 Xray 版本：v${CUR_VER}"
        fi
        if [ "${CUR_VER}" = "${XVERSION}" ] && [ "${CUR_VER}" != "0" ]; then
            echo_date "本地 Xray 已是最新版本，无需更新！退出程序。"
            exit 0
        fi
    fi

    echo_date "开始下载..."
    update_now "v${XVERSION}"
}

update_now(){
    local ver=$1
    # 门禁：版本号非法时绝不进入下载
    local ver_num="${ver#v}"
    if [ -z "$ver" ] || ! is_valid_version "$ver_num"; then
        echo_date "版本号无效（${ver:-空}），中止下载。"
        exit 1
    fi

    rm -rf /tmp/xray
    mkdir -p /tmp/xray && cd /tmp/xray

    DL_BASE="https://github.com/XTLS/Xray-core/releases/download/${ver}"
    
    echo_date "开始下载校验文件：${ZIP_NAME}.dgst"
    curl $CURL_OPT --connect-timeout 15 -fSL -o /tmp/xray/${ZIP_NAME}.dgst "${DL_BASE}/${ZIP_NAME}.dgst"
    if [ "$?" != "0" ] || [ ! -s /tmp/xray/${ZIP_NAME}.dgst ]; then
        echo_date "${ZIP_NAME}.dgst 下载失败！"
        dgst_ok=0
    else
        dgst_ok=1
        echo_date "校验文件下载成功..."
    fi
    
    echo_date "开始下载 Xray 主程序压缩包..."
    echo_date "下载地址：${DL_BASE}/${ZIP_NAME}"
    curl $CURL_OPT --connect-timeout 15 -fSL -o /tmp/xray/${ZIP_NAME} "${DL_BASE}/${ZIP_NAME}"
    if [ "$?" != "0" ]; then
        echo_date "Xray 压缩包下载失败！"
        xray_ok=0
    else
        xray_ok=1
        echo_date "Xray 压缩包下载成功..."
    fi

    if [ "${dgst_ok}" = "1" ] && [ "${xray_ok}" = "1" ]; then
        check_hash
    else
        echo_date "下载流程失败，请检查你的 SOCKS5 代理是否正常工作！"
        exit 1
    fi
}

check_hash(){
    cd /tmp/xray
    echo_date "正在进行 SHA2-256 文件完整性校验..."
    
    ONLINE_HASH=$(grep "^SHA2-256=" "${ZIP_NAME}.dgst" | awk '{print $2}')
    LOCAL_HASH=$(sha256sum "${ZIP_NAME}" | awk '{print $1}')
    
    if [ -n "${ONLINE_HASH}" ] && [ "${LOCAL_HASH}" = "${ONLINE_HASH}" ]; then
        echo_date "文件校验通过，准备解压！"
        
        unzip -o "${ZIP_NAME}" xray >/dev/null 2>&1
        if [ -f "xray" ]; then
            install_binary
        else
            echo_date "解压失败或未找到 xray 二进制文件！"
            exit 1
        fi
    else
        echo_date "校验未通过，文件损坏或被劫持！"
        echo_date "本地 SHA2-256: $LOCAL_HASH"
        echo_date "线上 SHA2-256: $ONLINE_HASH"
        exit 1
    fi
}

install_binary(){
    echo_date "开始覆盖最新二进制文件..."
    if pidof koolss-xray >/dev/null 2>&1; then
        echo_date "正在关闭运行中的 Xray 主进程... "
        /data/softcenter/bin/koolss stop
        sleep 1
    fi

    mkdir -p /data/softcenter/bin/
    mv -f /tmp/xray/xray ${XRAY_BIN}
    chmod +x ${XRAY_BIN}
    echo_date "Xray 二进制文件更新成功！"

    if [ "$SSUP_NO_START" = "1" ]; then
        echo_date "SSUP_NO_START=1，跳过拉起 koolss（由调用方继续启动）"
    else
        echo_date "尝试启动代理服务..."
        /data/softcenter/bin/koolss start
        sleep 2
        if pidof koolss-xray >/dev/null 2>&1; then
            echo_date "Xray 启动成功！目前运行 PID：$(pidof koolss-xray)"
        else
            echo_date "致命错误：Xray 进程启动失败，请检查配置文件格式！"
        fi
    fi

    rm -rf /tmp/xray
}

# ================= 脚本主流程 =================
[ "$SSUP_NO_START" = "1" ] || clear
echo_date "==================================================================="
echo_date "          Xray 核心更新脚本 (GitHub 官方源 + SOCKS5 代理)"
echo_date "==================================================================="
get_latest_version
echo_date "==================================================================="