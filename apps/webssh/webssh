#!/bin/sh

# UniFi SoftCenter · WebSSH (GoWebSSH)
# 面板配置：/data/softcenter/config/webssh.env
# 二进制：/data/softcenter/bin/webssh-core（缺则由 webssh-dl 下载）

# 状态探针：轻量，不写日志
if [ "$1" = "status" ]; then
    if pgrep -f webssh-core >/dev/null 2>&1; then
        echo "running"
        exit 0
    fi
    echo "stopped"
    exit 1
fi

CONFIG="/data/softcenter/config/webssh.env"
[ -f "$CONFIG" ] && . "$CONFIG"

BIN="/data/softcenter/bin/webssh-core"
DL="/data/softcenter/bin/webssh-dl"
# 使用二进制原生参数，而不是伪造 HOME
# 兼容旧 WEBSSH_HOME（曾指向目录，其下有 .GoWebSSH）
if [ -n "$WEBSSH_HOME" ]; then
    if [ -d "$WEBSSH_HOME/.GoWebSSH" ]; then
        WEBSSH_CONFIG_DIR="${WEBSSH_CONFIG_DIR:-$WEBSSH_HOME/.GoWebSSH}"
    else
        WEBSSH_CONFIG_DIR="${WEBSSH_CONFIG_DIR:-$WEBSSH_HOME}"
    fi
fi
WEBSSH_CONFIG_DIR="${WEBSSH_CONFIG_DIR:-/data/softcenter/webssh/config}"
WEBSSH_WEB_DIR="${WEBSSH_WEB_DIR:-/data/softcenter/webssh/web}"
WEBSSH_PORT="${WEBSSH_PORT:-8899}"
export TERM=xterm
LOG="/var/log/webssh.log"
PIDFILE="/var/run/webssh.pid"

log_date() {
    local line="【$(date '+%Y年%m月%d日 %H:%M:%S')】: $1"
    echo "$line"
    echo "$line" >> "$LOG"
}

ensure_bin() {
    # 损坏/非 ELF 时强制重下
    if [ -f "$BIN" ] && [ -x "$BIN" ]; then
        magic=$(dd if="$BIN" bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')
        if [ "$magic" = "7f454c46" ]; then
            return 0
        fi
        log_date "$BIN 不是有效 ELF，强制重新下载"
        FORCE_DOWNLOAD=1
    fi
    log_date "调用 webssh-dl 下载核心..."
    if [ -x "$DL" ]; then
        SSUP_NO_START=1 FORCE_DOWNLOAD="${FORCE_DOWNLOAD:-1}" "$DL"
    else
        log_date "未找到下载脚本 $DL"
        return 1
    fi
    [ -x "$BIN" ] || return 1
}

is_running() {
    pgrep -f webssh-core >/dev/null 2>&1
}

start_webssh() {
    ensure_bin || { log_date "WebSSH 二进制不可用"; exit 1; }
    if is_running; then
        echo "webssh 已在运行"
        return 0
    fi

    mkdir -p "$WEBSSH_CONFIG_DIR"
    # 旧数据迁移：$HOME/.GoWebSSH → ConfigDir
    OLD_CFG="/data/softcenter/bin/websshdata/.GoWebSSH"
    if [ -d "$OLD_CFG" ] && [ ! -f "$WEBSSH_CONFIG_DIR/GoWebSSH.toml" ]; then
        log_date "迁移旧配置 $OLD_CFG → $WEBSSH_CONFIG_DIR"
        cp -a "$OLD_CFG/." "$WEBSSH_CONFIG_DIR/" 2>/dev/null || true
    fi

    # 首次运行会生成 GoWebSSH.toml
    if [ -d "$WEBSSH_WEB_DIR" ]; then
        nohup "$BIN" -ConfigDir "$WEBSSH_CONFIG_DIR" -WebBaseDir "$WEBSSH_WEB_DIR" >> "$LOG" 2>&1 &
    else
        nohup "$BIN" -ConfigDir "$WEBSSH_CONFIG_DIR" >> "$LOG" 2>&1 &
    fi
    sleep 1
    if is_running; then
        pid=$(pgrep -f webssh-core | head -n 1)
        echo "$pid" > "$PIDFILE"
        log_date "WebSSH 启动成功 PID=$pid ConfigDir=$WEBSSH_CONFIG_DIR"
        echo "WebSSH 已启动，访问 http://$(hostname -I 2>/dev/null | awk '{print $1}'):${WEBSSH_PORT}/"
    else
        rm -f "$PIDFILE"
        log_date "WebSSH 启动失败，详见 $LOG"
        echo "启动失败，请查看 $LOG"
        exit 1
    fi
}

stop_webssh() {
    if is_running; then
        pkill -f webssh-core 2>/dev/null
        sleep 1
        pkill -9 -f webssh-core 2>/dev/null
        log_date "WebSSH 已停止"
        echo "WebSSH 已停止"
    else
        echo "WebSSH 未在运行"
    fi
    rm -f "$PIDFILE"
}

case "${1}" in
start)
    start_webssh
    ;;
stop)
    stop_webssh
    ;;
restart)
    stop_webssh
    sleep 1
    start_webssh
    ;;
status)
    exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
