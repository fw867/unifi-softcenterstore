#!/bin/sh

# UniFi SoftCenter · 下载最新 GoWebSSH-linux-arm64
# 默认从 GitHub latest release 拉取，不固定版本号
# SSUP_NO_START=1 时只安装不拉起 webssh

alias echo_date='echo 【$(date "+%Y年%m月%d日 %H:%M:%S")】:'

BIN="/data/softcenter/bin/webssh-core"
WEBSSH_BIN="/data/softcenter/bin/webssh"
VER_FILE="/data/softcenter/bin/webssh-core.version"
DL_DIR="/data/softcenter/bin/websshrule"
ZIP_NAME="GoWebSSH-linux-arm64.zip"
API_LATEST="https://api.github.com/repos/o8oo8o/WebSSH/releases/latest"
FORCE_DOWNLOAD="${FORCE_DOWNLOAD:-0}"
SSUP_NO_START="${SSUP_NO_START:-0}"

# 代理：读软件中心「系统设置 → 全局更新代理」(/data/softcenter/config.json 的 LocalProxy)
SC_PROXY=$(sed -n 's/.*"LocalProxy"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /data/softcenter/config.json 2>/dev/null | head -n1)
CURL_OPT=""
if [ -n "$SC_PROXY" ]; then
    CURL_OPT="-x $SC_PROXY"
    echo_date "升级代理（全局更新代理）: $SC_PROXY"
else
    echo_date "未配置全局更新代理，直连 GitHub"
fi

arch=$(uname -m)
case $arch in
    aarch64|arm64) ;;
    *)
        echo_date "暂不支持的架构: $arch（仅 arm64）"
        exit 1
        ;;
esac

is_valid_version() {
    echo "$1" | grep -Eq '^[0-9]+(\.[0-9]+)+$'
}

# 本地版本：优先二进制 -v/--version，其次安装时写入的版本文件
get_local_version() {
    local v=""
    if [ -x "$BIN" ]; then
        v=$("$BIN" version 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
        [ -z "$v" ] && v=$("$BIN" -v 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
        [ -z "$v" ] && v=$("$BIN" --version 2>/dev/null | head -n1 | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)
    fi
    if [ -z "$v" ] && [ -f "$VER_FILE" ]; then
        v=$(tr -d ' \r\n' < "$VER_FILE")
    fi
    printf '%s' "$v"
}

human_size() {
    awk -v b="${1:-0}" 'BEGIN{
        split("B KB MB GB", u, " ")
        i = 1
        while (b >= 1024 && i < 4) { b /= 1024; i++ }
        if (i == 1) printf "%d %s", b, u[i]
        else printf "%.1f %s", b, u[i]
    }'
}

download_with_progress() {
    local url="$1"
    local out="$2"
    local err="/tmp/webssh_curl.err"
    local pid last=0 p got

    : > "$err"
    curl $CURL_OPT -fL --connect-timeout 15 --max-time 300 -o "$out" "$url" 2>"$err" &
    pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        sleep 1
        p=$(tr '\r' '\n' < "$err" 2>/dev/null | sed -n 's/.*[[:space:]]\([0-9][0-9]*\)[[:space:]]*%.*/\1/p' | tail -n1)
        p=${p:-0}
        if [ "$p" -ge $((last + 10)) ] || [ "$p" -ge 100 ]; then
            got=$(wc -c < "$out" 2>/dev/null || echo 0)
            echo_date "▸ 进度 ${p}%  已下载 $(human_size "$got")"
            last=$p
        fi
    done

    wait "$pid"
}

echo_date "查询 GitHub latest release..."
LATEST_JSON=$(curl $CURL_OPT --connect-timeout 10 --max-time 30 -fsSL "$API_LATEST")
if [ -z "$LATEST_JSON" ]; then
    echo_date "获取 latest 失败，请检查网络或全局更新代理后重试"
    exit 1
fi

TAG=$(printf '%s' "$LATEST_JSON" | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/')
# 与 SoftCenter install.sh 一致：直接从完整响应抠 zip URL 与 sha256
DL_URL=$(printf '%s' "$LATEST_JSON" | grep -oE 'https://[^"]*GoWebSSH[^"]*\.zip' | head -n1)
ZIP_SHA256=$(printf '%s' "$LATEST_JSON" | grep -oE 'sha256:[a-fA-F0-9]{64}' | head -n1 | sed 's/^sha256://')

if [ -z "$DL_URL" ]; then
    echo_date "未找到 ${ZIP_NAME} 的下载地址（tag=${TAG:-?}）"
    exit 1
fi
if [ -z "$ZIP_SHA256" ]; then
    echo_date "Release 资源缺少 SHA256 digest，为安全起见中止"
    echo_date "  下载地址: $DL_URL"
    exit 1
fi

ONLINE_VER=$(printf '%s' "$TAG" | sed 's/^[vV]//')
if ! is_valid_version "$ONLINE_VER"; then
    echo_date "解析线上版本号失败（得到：${TAG:-空}），已中止"
    exit 1
fi
echo_date "线上最新版本: v${ONLINE_VER}"

if [ -x "$BIN" ] && [ "$FORCE_DOWNLOAD" != "1" ]; then
    CUR_VER=$(get_local_version)
    if [ -n "$CUR_VER" ]; then
        echo_date "当前已安装版本: v${CUR_VER}"
        if [ "$CUR_VER" = "$ONLINE_VER" ]; then
            echo_date "本地已是最新版本，无需更新"
            if [ "$SSUP_NO_START" != "1" ] && [ -x "$WEBSSH_BIN" ]; then
                "$WEBSSH_BIN" start
            fi
            exit 0
        fi
    else
        echo_date "无法识别本地版本，将强制下载覆盖"
    fi
else
    echo_date "本地无核心或指定强制更新，开始下载"
fi

echo_date "下载: $DL_URL"
echo_date "期望校验: $ZIP_SHA256"

rm -rf "$DL_DIR"
mkdir -p "$DL_DIR" || exit 1

echo_date "▸ 下载更新包"
if ! download_with_progress "$DL_URL" "${DL_DIR}/${ZIP_NAME}" || [ ! -s "${DL_DIR}/${ZIP_NAME}" ]; then
    echo_date "下载失败"
    rm -rf "$DL_DIR"
    exit 1
fi
ZIP_SIZE=$(wc -c < "${DL_DIR}/${ZIP_NAME}" | tr -d ' ')
echo_date "  下载完成: $(human_size "$ZIP_SIZE")"

echo_date "▸ 比对 SHA256"
LOCAL_HASH=$(sha256sum "${DL_DIR}/${ZIP_NAME}" | awk '{print $1}')
if [ "$LOCAL_HASH" != "$ZIP_SHA256" ]; then
    echo_date "SHA256 校验失败，已中止，不会覆盖本地文件"
    echo_date "  期望: $ZIP_SHA256"
    echo_date "  实际: $LOCAL_HASH"
    rm -rf "$DL_DIR"
    exit 1
fi
echo_date "✅ 校验通过  $LOCAL_HASH"

echo_date "解压..."
unzip -o "${DL_DIR}/${ZIP_NAME}" -d "$DL_DIR" >/dev/null 2>&1 || {
    echo_date "解压失败"
    rm -rf "$DL_DIR"
    exit 1
}

SRC=""
for f in gossh GoWebSSH webssh GoWebSSH-linux-arm64; do
    if [ -f "${DL_DIR}/${f}" ]; then
        SRC="${DL_DIR}/${f}"
        break
    fi
done
if [ -z "$SRC" ]; then
    SRC=$(find "$DL_DIR" -type f ! -name '*.zip' 2>/dev/null | xargs ls -S 2>/dev/null | head -n 1)
fi
if [ ! -f "$SRC" ]; then
    echo_date "未在压缩包中找到可执行文件"
    ls -la "$DL_DIR"
    rm -rf "$DL_DIR"
    exit 1
fi

mkdir -p /data/softcenter/bin
if pgrep -f webssh-core >/dev/null 2>&1; then
    [ -x "$WEBSSH_BIN" ] && "$WEBSSH_BIN" stop
fi
mv -f "$SRC" "$BIN"
chmod +x "$BIN"
printf '%s\n' "$ONLINE_VER" > "$VER_FILE"
echo_date "已安装 ${BIN} v${ONLINE_VER}"

# 压缩包若带 web/ 静态资源，解压到 WebBaseDir 供 -WebBaseDir 使用
WEB_SRC=""
for d in "$DL_DIR/web" "$DL_DIR/Web" "$DL_DIR/static"; do
    if [ -d "$d" ]; then WEB_SRC="$d"; break; fi
done
if [ -n "$WEB_SRC" ]; then
    WEB_DST="/data/softcenter/webssh/web"
    mkdir -p "$WEB_DST"
    cp -rf "$WEB_SRC/." "$WEB_DST/"
    echo_date "已部署 Web 静态资源 → $WEB_DST"
fi

rm -rf "$DL_DIR"

if [ "$SSUP_NO_START" = "1" ]; then
    echo_date "SSUP_NO_START=1，跳过拉起 webssh"
elif [ -x "$WEBSSH_BIN" ]; then
    "$WEBSSH_BIN" start
fi
