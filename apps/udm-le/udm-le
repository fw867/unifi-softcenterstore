#!/bin/sh

# UniFi SoftCenter · udm-le 管理
# 上游: https://github.com/kchristensen/udm-le
# start: 生成 env 并安装/续期；stop: 禁用 systemd timer
# 配置: /data/softcenter/config/udm-le.env

CONFIG="/data/softcenter/config/udm-le.env"
[ -f "$CONFIG" ] && . "$CONFIG"

DATA_DIR="/data/softcenter/bin/udm-ledata"
UDM_LE_DIR="$DATA_DIR"
LOG="/var/log/udm-le.log"
LE_TIMER="udm-le.timer"

log_date() {
    line="【$(date '+%Y年%m月%d日 %H:%M:%S')】: $1"
    echo "$line"
    echo "$line" >> "$LOG"
}

# 状态探针
if [ "$1" = "status" ]; then
    if systemctl is-active --quiet "$LE_TIMER" 2>/dev/null || crontab -l 2>/dev/null | grep -q "udm-le.sh renew"; then
        echo "running"
        exit 0
    fi
    echo "stopped"
    exit 1
fi

# 生成上游可识别的 udm-le.env
write_upstream_env() {
    mkdir -p "$UDM_LE_DIR/.secrets" "$UDM_LE_DIR/.lego"
    cat > "$UDM_LE_DIR/udm-le.env" <<EOF
CERT_EMAIL="${CERT_EMAIL:-}"
CERT_HOSTS="${CERT_HOSTS:-}"
CERT_DAYS_BEFORE_RENEWAL="${CERT_DAYS_BEFORE_RENEWAL:-30}"
ENABLE_CAPTIVE="${ENABLE_CAPTIVE:-no}"
NO_BUNDLE="${NO_BUNDLE:-no}"
ENABLE_EUS_CERTS="${ENABLE_EUS_CERTS:-yes}"
KEY_TYPE="${KEY_TYPE:-RSA2048}"
ENABLE_RADIUS="${ENABLE_RADIUS:-no}"
LEGO_DISABLE_CNAME_SUPPORT=true
DNS_RESOLVER="${DNS_RESOLVER:-127.0.0.1:53}"
DNS_PROVIDER="${DNS_PROVIDER:-cloudflare}"
CLOUDFLARE_DNS_API_TOKEN="${CLOUDFLARE_DNS_API_TOKEN:-}"
DUCKDNS_TOKEN="${DUCKDNS_TOKEN:-}"
DO_AUTH_TOKEN="${DO_AUTH_TOKEN:-}"
AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}"
AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}"
AWS_REGION="${AWS_REGION:-}"
AWS_HOSTED_ZONE_ID="${AWS_HOSTED_ZONE_ID:-}"
LINODE_TOKEN="${LINODE_TOKEN:-}"
GANDIV5_PERSONAL_ACCESS_TOKEN="${GANDIV5_PERSONAL_ACCESS_TOKEN:-}"
NAMECOM_USERNAME="${NAMECOM_USERNAME:-}"
NAMECOM_API_TOKEN="${NAMECOM_API_TOKEN:-}"
GOOGLE_DOMAINS_ACCESS_TOKEN="${GOOGLE_DOMAINS_ACCESS_TOKEN:-}"
EXTRA_ARGS=""
DNS_RESOLVERS=""
UDM_LE_PATH="${UDM_LE_DIR}"
LEGO_VERSION="${LEGO_VERSION:-4.35.2}"
LEGO_SHA1="${LEGO_SHA1:-c2b4c950652595e9b3ce32ed296d09fd6ffa3c50}"
LEGO_DOWNLOAD_URL="https://github.com/go-acme/lego/releases/download/v\${LEGO_VERSION}/lego_v\${LEGO_VERSION}_linux_arm64.tar.gz"
LEGO_BINARY="${UDM_LE_DIR}/lego"
LEGO_PATH="${UDM_LE_DIR}/.lego"
JAVA_BINARY="/usr/bin/java"
UBIOS_CONTROLLER_CERT_PATH="/data/unifi-core/config"
UBIOS_RADIUS_CERT_PATH="/etc/freeradius/3.0/certs"
UNIFIOS_CERT_PATH="/data/unifi-core/config"
UNIFIOS_EUS_CERT_PATH="/data/eus_certificates"
UNIFIOS_KEYSTORE_CERT_ALIAS="unifi"
UNIFIOS_KEYSTORE_PASSWORD="aircontrolenterprise"
UNIFIOS_KEYSTORE_PATH="/usr/lib/unifi/data"
EOF
    chmod 600 "$UDM_LE_DIR/udm-le.env"
}

ensure_upstream() {
    if [ -x "$UDM_LE_DIR/udm-le.sh" ]; then
        return 0
    fi
    log_date "下载 udm-le 上游脚本与资源..."
    mkdir -p "$UDM_LE_DIR/resources/systemd"
    RAW="https://raw.githubusercontent.com/kchristensen/udm-le/main"
    curl -fsSL -o "$UDM_LE_DIR/udm-le.sh" "$RAW/udm-le.sh" || {
        log_date "下载 udm-le.sh 失败"
        return 1
    }
    curl -fsSL -o "$UDM_LE_DIR/resources/systemd/udm-le.service" "$RAW/resources/systemd/udm-le.service" || true
    curl -fsSL -o "$UDM_LE_DIR/resources/systemd/udm-le.timer" "$RAW/resources/systemd/udm-le.timer" || true
    chmod +x "$UDM_LE_DIR/udm-le.sh"
    # 改写硬编码路径为 SoftCenter 数据目录
    sed -i "s|/data/udm-le|${UDM_LE_DIR}|g" "$UDM_LE_DIR/udm-le.sh" "$UDM_LE_DIR/resources/systemd/"* 2>/dev/null || true
    log_date "udm-le 上游文件就绪"
}

case "${1}" in
start)
    if [ -z "$CERT_EMAIL" ] || [ -z "$CERT_HOSTS" ]; then
        echo "请先在软件中心配置 CERT_EMAIL 与 CERT_HOSTS"
        log_date "缺少 CERT_EMAIL / CERT_HOSTS"
        exit 1
    fi
    ensure_upstream || exit 1
    write_upstream_env
    log_date "执行 udm-le initial..."
    (cd "$UDM_LE_DIR" && ./udm-le.sh initial) >> "$LOG" 2>&1
    if [ $? -eq 0 ]; then
        log_date "udm-le initial 完成"
        echo "udm-le 已启动"
    else
        log_date "udm-le initial 失败，详见 $LOG"
        echo "启动失败，请查看 $LOG"
        exit 1
    fi
    ;;
stop)
    systemctl disable --now udm-le.timer >/dev/null 2>&1 || true
    systemctl stop udm-le.service >/dev/null 2>&1 || true
    crontab -l 2>/dev/null | grep -v "udm-le.sh renew" | crontab - 2>/dev/null || true
    log_date "已停止续期定时器"
    echo "udm-le 已停止"
    ;;
renew)
    ensure_upstream || exit 1
    write_upstream_env
    (cd "$UDM_LE_DIR" && ./udm-le.sh renew) >> "$LOG" 2>&1
    echo "续期完成，详见 $LOG"
    ;;
status)
    exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|renew|status}"
    exit 1
    ;;
esac
