            },
            {
                "Name": "fakehttp-dl",
                "Path": "apps/fakehttp/fakehttp-dl",
                "Sha256": "4883a0eda7888ceb48e0a9c318f24c6c0ff5b20050b09b3fd7447570ab49ef19",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "混淆设置",
                    "Tab": "基本设置",
                    "Fields": [
                        {
                            "Key": "FAKEHTTP_HOST",
                            "Label": "HTTP 混淆域名",
                            "Type": "text",
                            "Default": "www.example.com",
                            "Required": true,
                            "Placeholder": "www.example.com",
                            "Help": "对应 -h；与 HTTPS 域名至少填一个"
                        },
                        {
                            "Key": "FAKEHTTP_HTTPS_HOST",
                            "Label": "HTTPS 混淆域名",
                            "Type": "text",
                            "Default": "",
                            "Placeholder": "www.example.com",
                            "Help": "对应 -e，可选"
                        },
                        {
                            "Key": "FAKEHTTP_IFACE",
                            "Label": "网络接口",
                            "Type": "text",
                            "Default": "ppp0",
                            "Placeholder": "ppp0",
                            "Help": "对应 -i；默认 ppp0。清空则自动探测（ppp0 → PPPoE 物理口 → 默认路由）"
                        }
                    ]
                },
                {
                    "Title": "运行选项",
                    "Tab": "进阶设置",
                    "Fields": [
                        {
                            "Key": "FAKEHTTP_USE_IPTABLES",
                            "Label": "使用 iptables",
                            "Type": "switch",
                            "Default": "0",
                            "Help": "对应 -z；默认优先 nftables"
                        },
                        {
                            "Key": "FAKEHTTP_DYN_TTL",
                            "Label": "动态 TTL",
                            "Type": "switch",
                            "Default": "0",
                            "Help": "对应 -y；将 TTL 提升至估算跃点数的百分比"
                        },
                        {
                            "Key": "FAKEHTTP_TTL_PCT",
                            "Label": "动态 TTL 百分比",
                            "Type": "number",
                            "Default": "50",
                            "Min": 10,
                            "Max": 200,
                            "VisibleWhen": "FAKEHTTP_DYN_TTL=1",
                            "Help": "对应 -y；建议 50-70，将 TTL 提升至估算跃点数的该百分比"
                        },
                        {
                            "Key": "FAKEHTTP_SILENT",
                            "Label": "静默模式",
                            "Type": "switch",
                            "Default": "0",
                            "Help": "对应 -s；日志中不记录 IP"
                        },
                        {
                            "Key": "FAKEHTTP_DEBUG",
                            "Label": "调试日志",
                            "Type": "switch",
                            "Default": "0",
                            "Help": "开启后核心运行日志写入下方日志路径（fakehttp -w）"
                        },
                        {
                            "Key": "FAKEHTTP_LOG",
                            "Label": "日志路径",
                            "Type": "path",
                            "Default": "/var/log/fakehttp.log",
                            "Monospace": true
                        }
                    ]
                }
            ]
        }
