[
    {
        "Id": "tomodem",
        "Name": "光猫助手",
        "Type": "Shell Script",
        "Version": "1.2.0",
        "Description": "配置路由和光猫IP，完美解决内网和光猫互通问题。",
        "Icon": "router",
        "StartCommand": "/data/softcenter/bin/tomodem start",
        "StopCommand": "/data/softcenter/bin/tomodem stop",
        "StatusCommand": "iptables -L FORWARD | grep -c \"softcenter:tomodem\" > /dev/null",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/tomodem.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/tomodem.log",
        "Files": [
            {
                "Name": "tomodem",
                "Path": "apps/tomodem/tomodem",
                "Sha256": "1037407f1c18f0c238ef51bb6d3fe5eb2818971ee6a34f6e1ad0020c504e7eea",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "基础配置",
                    "Fields": [
                        {
                            "Key": "tomodem_ip",
                            "Label": "光猫管理 IP",
                            "Type": "ip",
                            "Default": "192.168.1.1",
                            "Placeholder": "192.168.1.1",
                            "Required": true,
                            "Help": "光猫后台地址"
                        },
                        {
                            "Key": "tomodem_eth",
                            "Label": "内网网口",
                            "Type": "select",
                            "Default": "eth0",
                            "Options": [
                                {
                                    "Label": "eth0",
                                    "Value": "eth0"
                                },
                                {
                                    "Label": "eth1",
                                    "Value": "eth1"
                                },
                                {
                                    "Label": "eth2",
                                    "Value": "eth2"
                                },
                                {
                                    "Label": "eth3",
                                    "Value": "eth3"
                                },
                                {
                                    "Label": "eth4",
                                    "Value": "eth4"
                                },
                                {
                                    "Label": "eth5",
                                    "Value": "eth5"
                                },
                                {
                                    "Label": "eth6",
                                    "Value": "eth6"
                                }
                            ],
                            "Help": "路由连接光猫的网口"
                        }
                    ]
                }
            ]
        }
    },
    {
        "Id": "koolss",
        "Name": "V2Ray",
        "Type": "Binary Core",
        "Version": "1.0.1",
        "Description": "V2ray代理，支持GFWList、大陆白名单，游戏、全局模式。",
        "Icon": "shield-check",
        "StartCommand": "systemctl start koolss",
        "StopCommand": "systemctl stop koolss",
        "StatusCommand": "systemctl is-active --quiet koolss",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/koolss.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/koolss.log",
        "CustomCommands": "[{\"name\":\"升级xray\",\"command\":\"/data/bin/ssup\"},{\"name\":\"更新规则\",\"command\":\"/data/bin/ssrule\"}]",
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "核心配置",
                    "Fields": [
                        {
                            "Key": "V2RAY_CONFIG_FILE",
                            "Label": "配置文件路径",
                            "Type": "path",
                            "Default": "/data/koolss/config.json",
                            "Monospace": true,
                            "Help": "V2Ray / Xray 主配置文件"
                        },
                        {
                            "Key": "v2ray_udp",
                            "Label": "启用 UDP 转发",
                            "Type": "switch",
                            "Default": "1"
                        },
                        {
                            "Key": "v2ray_udp_list",
                            "Label": "UDP 端口列表",
                            "Type": "text",
                            "Default": "",
                            "Placeholder": "如 1:65535 或留空",
                            "VisibleWhen": "v2ray_udp=1",
                            "Help": "需要转发的 UDP 端口范围"
                        }
                    ]
                },
                {
                    "Title": "DNS",
                    "Fields": [
                        {
                            "Key": "ISP_DNS1",
                            "Label": "运营商 DNS 1",
                            "Type": "ip",
                            "Default": "223.5.5.5"
                        },
                        {
                            "Key": "ISP_DNS2",
                            "Label": "运营商 DNS 2",
                            "Type": "ip",
                            "Default": "119.29.29.29"
                        },
                        {
                            "Key": "v2ray_basic_dns_chromecast",
                            "Label": "Chromecast DNS 分流",
                            "Type": "switch",
                            "Default": "0"
                        }
                    ]
                },
                {
                    "Title": "分流模式",
                    "Fields": [
                        {
                            "Key": "v2ray_acl_default_mode",
                            "Label": "默认代理模式",
                            "Type": "select",
                            "Default": "gfw",
                            "Options": [
                                {
                                    "Label": "GFW 名单",
                                    "Value": "gfw"
                                },
                                {
                                    "Label": "大陆白名单",
                                    "Value": "chn"
                                },
                                {
                                    "Label": "全局代理",
                                    "Value": "global"
                                },
                                {
                                    "Label": "不代理",
                                    "Value": "direct"
                                }
                            ]
                        },
                        {
                            "Key": "v2ray_bypass",
                            "Label": "直连域名/IP",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 4,
                            "Monospace": true,
                            "Placeholder": "每行一条，支持域名或 CIDR"
                        },
                        {
                            "Key": "v2ray_quic_reject",
                            "Label": "拦截 QUIC",
                            "Type": "switch",
                            "Default": "0"
                        }
                    ]
                }
            ]
        }
    },
    {
        "Id": "wechat",
        "Name": "微信通知",
        "Type": "Shell Script",
        "Version": "1.2.0",
        "Description": "路由重新拨号后通过企业微信机器人通知新IP。",
        "Icon": "message-circle",
        "StartCommand": "/data/softcenter/bin/wechat start",
        "StopCommand": "/data/softcenter/bin/wechat stop",
        "StatusCommand": "[ -f \"/etc/ppp/ip-up.d/wechat\" ]",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/wechat.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/wechat.log",
        "Files": [
            {
                "Name": "wechat",
                "Path": "apps/wechat/wechat",
                "Sha256": "28a310c052ceaa9a374c2e71c1c3786454ea925fd3dcb702860cbd968db88b7f",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "企业微信机器人",
                    "Fields": [
                        {
                            "Key": "WEBHOOK_KEY",
                            "Label": "Webhook Key",
                            "Type": "password",
                            "Default": "",
                            "Required": true,
                            "Secret": true,
                            "Help": "企业微信群机器人 webhook 的 key"
                        },
                        {
                            "Key": "Routing_Remarks",
                            "Label": "路由备注",
                            "Type": "text",
                            "Default": "",
                            "Placeholder": "如：家宽 / 公司出口",
                            "Help": "通知卡片标题前缀，可留空"
                        }
                    ]
                }
            ]
        }
    },
    {
