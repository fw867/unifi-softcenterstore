    {
        "Id": "fan-control",
        "Name": "风扇调速",
        "Type": "Shell Script",
        "Version": "1.0.0",
        "Description": "UCG-Max/Fibre 智能风扇调速（iceteaSA/unifi-fan-control），按 CPU 温度自适应调速。",
        "Icon": "fan",
        "StartCommand": "/data/softcenter/bin/fan-control start",
        "StopCommand": "/data/softcenter/bin/fan-control stop",
        "StatusCommand": "/data/softcenter/bin/fan-control status",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/fan-control.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/fan-control.log",
        "CustomCommands": "[{\"name\":\"查看系统日志\",\"command\":\"logger -t fan-control test >/dev/null 2>&1; tail -n 50 /var/log/fan-control.log 2>/dev/null; journalctl -t fan-control -n 50 --no-pager 2>/dev/null || true\"}]",
        "Files": [
            {
                "Name": "fan-control",
                "Path": "apps/fan-control/fan-control",
                "Sha256": "872191087fd0b6a2e754a57d8333239b3b24208e0be2f6af92a13a4cd7c66f57",
                "Mode": "0755"
            },
            {
                "Name": "fan-control.sh",
                "Path": "apps/fan-control/fan-control.sh",
                "Sha256": "a7662e5d19b919a33b4ef4c805bed92d6c990d738926104b57ff784e82d40afe",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "温度阈值",
                    "Tab": "基础设置",
                    "Fields": [
                        {
                            "Key": "MIN_TEMP",
                            "Label": "启动阈值 (°C)",
                            "Type": "number",
                            "Default": "60",
                            "Min": 30,
                            "Max": 80,
                            "Help": "达到此温度后风扇开始工作（加上滞回）"
                        },
                        {
                            "Key": "MAX_TEMP",
                            "Label": "紧急阈值 (°C)",
                            "Type": "number",
                            "Default": "85",
                            "Min": 50,
                            "Max": 100,
                            "Help": "达到此温度后强制满速"
                        },
                        {
                            "Key": "HYSTERESIS",
                            "Label": "滞回缓冲 (°C)",
                            "Type": "number",
                            "Default": "5",
                            "Min": 1,
                            "Max": 15,
                            "Help": "启动温度 = MIN_TEMP + HYSTERESIS"
                        }
                    ]
                },
                {
                    "Title": "风扇转速",
                    "Tab": "基础设置",
                    "Fields": [
                        {
                            "Key": "MIN_PWM",
                            "Label": "最小转速 PWM",
                            "Type": "number",
                            "Default": "91",
                            "Min": 0,
                            "Max": 255,
                            "Help": "ACTIVE 模式最低 PWM (0-255)"
                        },
                        {
                            "Key": "MAX_PWM",
                            "Label": "最大转速 PWM",
                            "Type": "number",
                            "Default": "255",
                            "Min": 1,
                            "Max": 255
                        },
                        {
                            "Key": "MAX_PWM_STEP",
                            "Label": "单次调整上限",
                            "Type": "number",
                            "Default": "25",
                            "Min": 1,
                            "Max": 50,
                            "Help": "每次调整允许的最大 PWM 变化量"
                        }
                    ]
                },
                {
                    "Title": "运行策略",
                    "Tab": "进阶调节",
                    "Fields": [
                        {
                            "Key": "CHECK_INTERVAL",
                            "Label": "检测间隔 (秒)",
                            "Type": "number",
                            "Default": "15",
                            "Min": 5,
                            "Max": 60
                        },
                        {
                            "Key": "TAPER_MINS",
                            "Label": "冷却时长 (分钟)",
                            "Type": "number",
                            "Default": "90",
                            "Min": 1,
                            "Max": 240,
                            "Help": "TAPER 低速吹风持续时间"
                        },
                        {
                            "Key": "ALPHA",
                            "Label": "温度平滑系数",
                            "Type": "number",
                            "Default": "20",
                            "Min": 1,
                            "Max": 99,
                            "Help": "越小越贴近原始温度，越大越平滑"
                        },
                        {
                            "Key": "DEADBAND",
                            "Label": "死区 (°C)",
                            "Type": "number",
                            "Default": "1",
                            "Min": 0,
                            "Max": 10
                        },
                        {
                            "Key": "LEARNING_RATE",
                            "Label": "学习步长",
                            "Type": "number",
                            "Default": "5",
                            "Min": 1,
                            "Max": 20,
                            "Help": "自适应 PWM 优化步长"
                        }
                    ]
                },
                {
                    "Title": "硬件",
                    "Tab": "进阶调节",
                    "Fields": [
                        {
                            "Key": "FAN_PWM_DEVICE",
                            "Label": "PWM 设备路径",
                            "Type": "path",
                            "Default": "/sys/class/hwmon/hwmon0/pwm1",
                            "Monospace": true,
                            "Help": "单风扇路径；新版脚本支持自动检测多风扇"
                        },
                        {
                            "Key": "OPTIMAL_PWM_FILE",
                            "Label": "最优 PWM 状态文件",
                            "Type": "path",
                            "Default": "/data/softcenter/bin/fan-controldata/optimal_pwm",
                            "Monospace": true
                        }
                    ]
                }
            ]
        }
    }
]
