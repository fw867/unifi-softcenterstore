        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "配置文件",
                    "Tab": "基本设置",
                    "Fields": [
                        {
                            "Key": "V2RAY_CONFIG_FILE",
                            "Label": "V2Ray 配置",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 25,
                            "Monospace": true,
                            "Required": true,
                            "Placeholder": "粘贴完整的 Xray / V2Ray JSON 配置",
                            "Help": "多行内容会以 base64 存入 config.env，启动时解码到 /tmp/xray.json"
                        },
                        {
                            "Key": "v2ray_acl_default_mode",
                            "Label": "默认代理模式",
                            "Type": "select",
                            "Default": "1",
                            "Options": [
                                {
                                    "Label": "不代理",
                                    "Value": "0"
                                },
                                {
                                    "Label": "GFWList",
                                    "Value": "1"
                                },
                                {
                                    "Label": "国内白名单",
                                    "Value": "2"
                                },
                                {
                                    "Label": "游戏模式",
                                    "Value": "3"
                                },
                                {
                                    "Label": "全局代理",
                                    "Value": "4"
                                }
                            ]
                        },
                        {
                            "Key": "v2ray_bypass",
                            "Label": "国内白名单方式",
                            "Type": "select",
                            "Default": "2",
                            "Options": [
                                {
                                    "Label": "chnroute 列表",
                                    "Value": "1"
                                },
                                {
                                    "Label": "GeoIP",
                                    "Value": "2"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Title": "DNS",
                    "Tab": "DNS设置",
                    "Fields": [
                        {
                            "Key": "ISP_DNS1",
                            "Label": "运营商 DNS 1",
                            "Type": "ip",
                            "Default": "223.5.5.5"
                        },
                        {
                            "Key": "ISP_DNS2",
                            "Label": "运营商 DNS 2",
                            "Type": "ip",
                            "Default": "114.114.114.114"
                        },
                        {
                            "Key": "v2ray_basic_dns_chromecast",
                            "Label": "DNS 劫持",
                            "Type": "switch",
                            "Default": "1",
                            "Help": "强制局域网设备使用路由器 DNS"
                        }
                    ]
                },
                {
                    "Title": "域名名单",
                    "Tab": "黑白名单设置",
                    "Fields": [
                        {
                            "Key": "white_domain_list",
                            "Label": "域名白名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 8,
                            "Monospace": true,
                            "Placeholder": "每行一个域名，# 开头为注释",
                            "Help": "直连并走运营商 DNS，写入 white_list ipset"
                        },
                        {
                            "Key": "black_domain_list",
                            "Label": "域名黑名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 8,
                            "Monospace": true,
                            "Placeholder": "每行一个域名，# 开头为注释",
                            "Help": "走本地防污染 DNS，写入 black_list ipset"
                        }
                    ]
                },
                {
                    "Title": "IP 名单",
                    "Tab": "黑白名单设置",
                    "Fields": [
                        {
                            "Key": "white_ip_list",
                            "Label": "IP 白名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 6,
                            "Monospace": true,
                            "Placeholder": "每行一个 IP 或 CIDR，# 为注释",
                            "Help": "直连，写入 white_list ipset"
                        },
                        {
                            "Key": "black_ip_list",
                            "Label": "IP 黑名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 6,
                            "Monospace": true,
                            "Placeholder": "每行一个 IP 或 CIDR，# 为注释",
                            "Help": "强制走代理，写入 black_list ipset"
                        }
                    ]
                },
                {
                    "Title": "局域网 ACL",
                    "Tab": "ACL控制",
                    "Fields": [
                        {
                            "Key": "lan_acl_control",
                            "Label": "设备访问控制",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 12,
                            "Monospace": true,
                            "Placeholder": "每行一条，如：\nip=192.168.1.10 mode=1\nmac=AA:BB:CC:DD:EE:FF mode=0\nip=192.168.1.20 mac=AA:BB:CC:DD:EE:FF mode=2",
                            "Help": "mode：0不代理 / 1 GFW / 2国内 / 3游戏 / 4全局；ip、mac 可只填其一；省略 mode 则用默认代理模式"
                        }
                    ]
                },
                {
                    "Title": "UDP 与 QUIC",
                    "Tab": "UDP控制",
                    "Fields": [
                        {
                            "Key": "v2ray_udp",
                            "Label": "UDP 代理",
                            "Type": "switch",
                            "Default": "0"
                        },
                        {
                            "Key": "v2ray_udp_list",
                            "Label": "UDP 名单模式",
                            "Type": "switch",
                            "Default": "0",
                            "VisibleWhen": "v2ray_udp=1",
                            "Help": "udplist 内域名走游戏模式处理 UDP"
                        },
                        {
                            "Key": "v2ray_quic_reject",
                            "Label": "QUIC 阻断",
                            "Type": "select",
                            "Default": "0",
                            "Options": [
                                {
                                    "Label": "关闭",
                                    "Value": "0"
                                },
                                {
                                    "Label": "全局阻断",
                                    "Value": "1"
                                },
                                {
                                    "Label": "仅黑名单",
                                    "Value": "2"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
