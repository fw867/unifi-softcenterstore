[
    {
        "Id": "tomodem",
        "Name": "光猫助手",
        "Type": "Shell Script",
        "Version": "1.2.0",
        "Description": "配置路由和光猫IP，完美解决内网和光猫互通问题。",
        "Icon": "router",
        "StartCommand": "/data/softcenter/bin/tomodem start",
        "StopCommand": "/data/softcenter/bin/tomodem stop",
        "StatusCommand": "iptables -L FORWARD | grep -c \"softcenter:tomodem\" > /dev/null",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/tomodem.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/tomodem.log",
        "Files": [
            {
                "Name": "tomodem",
                "Path": "apps/tomodem/tomodem",
                "Sha256": "1037407f1c18f0c238ef51bb6d3fe5eb2818971ee6a34f6e1ad0020c504e7eea",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "基础配置",
                    "Fields": [
                        {
                            "Key": "tomodem_ip",
                            "Label": "光猫管理 IP",
                            "Type": "ip",
                            "Default": "192.168.1.1",
                            "Placeholder": "192.168.1.1",
                            "Required": true,
                            "Help": "光猫后台地址"
                        },
                        {
                            "Key": "tomodem_eth",
                            "Label": "内网网口",
                            "Type": "select",
                            "Default": "eth0",
                            "Options": [
                                {
                                    "Label": "eth0",
                                    "Value": "eth0"
                                },
                                {
                                    "Label": "eth1",
                                    "Value": "eth1"
                                },
                                {
                                    "Label": "eth2",
                                    "Value": "eth2"
                                },
                                {
                                    "Label": "eth3",
                                    "Value": "eth3"
                                },
                                {
                                    "Label": "eth4",
                                    "Value": "eth4"
                                },
                                {
                                    "Label": "eth5",
                                    "Value": "eth5"
                                },
                                {
                                    "Label": "eth6",
                                    "Value": "eth6"
                                }
                            ],
                            "Help": "路由连接光猫的网口"
                        }
                    ]
                }
            ]
        }
    },
    {
