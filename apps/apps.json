    {
        "Id": "tomodem",
        "Name": "光猫助手",
        "Type": "Shell Script",
        "Version": "1.3.0",
        "Description": "配置路由和光猫IP，完美解决内网和光猫互通问题。",
        "Icon": "router",
        "StartCommand": "/data/softcenter/bin/tomodem start",
        "StopCommand": "/data/softcenter/bin/tomodem stop",
        "StatusCommand": "/data/softcenter/bin/tomodem status",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/tomodem.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/tomodem.log",
        "CustomCommands": "[{\"name\":\"检查并修复网口\",\"command\":\"/data/softcenter/bin/tomodem check\"}]",
