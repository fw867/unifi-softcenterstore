[
    {
        "Id": "tomodem",
        "Name": "光猫助手",
        "Type": "Shell Script",
        "Version": "1.2.0",
        "Description": "配置路由和光猫IP，完美解决内网和光猫互通问题。",
        "Icon": "router",
        "StartCommand": "/data/softcenter/bin/tomodem start",
        "StopCommand": "/data/softcenter/bin/tomodem stop",
        "StatusCommand": "iptables -L FORWARD | grep -c \"softcenter:tomodem\" > /dev/null",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/tomodem.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/tomodem.log",
        "Files": [
            {
                "Name": "tomodem",
                "Path": "apps/tomodem/tomodem",
                "Sha256": "1037407f1c18f0c238ef51bb6d3fe5eb2818971ee6a34f6e1ad0020c504e7eea",
                "Mode": "0755"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "基础配置",
                    "Fields": [
                        {
                            "Key": "tomodem_ip",
                            "Label": "光猫管理 IP",
                            "Type": "ip",
                            "Default": "192.168.1.1",
                            "Placeholder": "192.168.1.1",
                            "Required": true,
                            "Help": "光猫后台地址"
                        },
                        {
                            "Key": "tomodem_eth",
                            "Label": "内网网口",
                            "Type": "select",
                            "Default": "eth0",
                            "Options": [
                                {
                                    "Label": "eth0",
                                    "Value": "eth0"
                                },
                                {
                                    "Label": "eth1",
                                    "Value": "eth1"
                                },
                                {
                                    "Label": "eth2",
                                    "Value": "eth2"
                                },
                                {
                                    "Label": "eth3",
                                    "Value": "eth3"
                                },
                                {
                                    "Label": "eth4",
                                    "Value": "eth4"
                                },
                                {
                                    "Label": "eth5",
                                    "Value": "eth5"
                                },
                                {
                                    "Label": "eth6",
                                    "Value": "eth6"
                                }
                            ],
                            "Help": "路由连接光猫的网口"
                        }
                    ]
                }
            ]
        }
    },
    {
        "Id": "koolss",
        "Name": "XRay",
        "Type": "Shell Script",
        "Version": "1.2.0",
        "Description": "Xray代理，支持GFWList、大陆白名单，游戏、全局模式。",
        "Icon": "shield-check",
        "StartCommand": "/data/softcenter/bin/koolss start",
        "StopCommand": "/data/softcenter/bin/koolss stop",
        "StatusCommand": "/data/softcenter/bin/koolss status",
        "IsAutoStart": 1,
        "ConfigPath": "/data/softcenter/config/koolss.env",
        "ConfigKeys": "",
        "LogPath": "/var/log/koolss.log",
        "CustomCommands": "[{\"name\":\"升级xray\",\"command\":\"/data/softcenter/bin/ssup\"},{\"name\":\"更新规则\",\"command\":\"/data/softcenter/bin/ssrule\"}]",
        "Files": [
            {
                "Name": "koolss",
                "Path": "apps/koolss/koolss",
                "Sha256": "e8c015a7fdc2a44f73e5cf1c45051ac9b00131e86f789cb194b5ee9745b6d97f",
                "Mode": "0755"
            },
            {
                "Name": "ssup",
                "Path": "apps/koolss/ssup",
                "Sha256": "cb72313512292bd737cd3f7e40caa296806fc0206d434a5f416f4a4b224f1188",
                "Mode": "0755"
            },
            {
                "Name": "ssrule",
                "Path": "apps/koolss/ssrule",
                "Sha256": "2c95320f2c832ae3c2bc8cc95c4ba73620dc2f7cc924a9a7425ccaced69f0569",
                "Mode": "0755"
            },
            {
                "Name": "koolssrule/rules.json.js",
                "Path": "apps/koolss/koolssrule/rules.json.js",
                "Sha256": "4151de881d71bc897875a098922ce7f2aac5cec7146fc0d6cb4f7563ade331a7",
                "Mode": "0644"
            },
            {
                "Name": "koolssrule/gfwlist.conf",
                "Path": "apps/koolss/koolssrule/gfwlist.conf",
                "Sha256": "e8ddfd8b99ac1c6881aea6cc038c01b8929fb49fb53f711255a611c0adaa9096",
                "Mode": "0644"
            },
            {
                "Name": "koolssrule/udplist.txt",
                "Path": "apps/koolss/koolssrule/udplist.txt",
                "Sha256": "837f64ff1eaa7c54575dc07ac3a115d31e59ce649d27121aa31451a1e7fe3f75",
                "Mode": "0644"
            },
            {
                "Name": "koolssrule/chnroute.txt",
                "Path": "apps/koolss/koolssrule/chnroute.txt",
                "Sha256": "38d209a4d74e99317e352f4f1ac59649f80e684ef917eb7cfc6d655e4943f0c9",
                "Mode": "0644"
            }
        ],
        "ConfigSchema": {
            "Sections": [
                {
                    "Title": "配置文件",
                    "Tab": "基本设置",
                    "Fields": [
                        {
                            "Key": "V2RAY_CONFIG_FILE",
                            "Label": "V2Ray 配置",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 25,
                            "Monospace": true,
                            "Required": true,
                            "Placeholder": "粘贴完整的 Xray / V2Ray JSON 配置",
                            "Help": "多行内容会以 base64 存入 config.env，启动时解码到 /tmp/xray.json"
                        },
                        {
                            "Key": "v2ray_acl_default_mode",
                            "Label": "默认代理模式",
                            "Type": "select",
                            "Default": "1",
                            "Options": [
                                {
                                    "Label": "不代理",
                                    "Value": "0"
                                },
                                {
                                    "Label": "GFWList",
                                    "Value": "1"
                                },
                                {
                                    "Label": "国内白名单",
                                    "Value": "2"
                                },
                                {
                                    "Label": "游戏模式",
                                    "Value": "3"
                                },
                                {
                                    "Label": "全局代理",
                                    "Value": "4"
                                }
                            ]
                        },
                        {
                            "Key": "v2ray_bypass",
                            "Label": "国内白名单方式",
                            "Type": "select",
                            "Default": "2",
                            "Options": [
                                {
                                    "Label": "chnroute 列表",
                                    "Value": "1"
                                },
                                {
                                    "Label": "GeoIP",
                                    "Value": "2"
                                }
                            ]
                        }
                    ]
                },
                {
                    "Title": "DNS",
                    "Tab": "DNS设置",
                    "Fields": [
                        {
                            "Key": "ISP_DNS1",
                            "Label": "运营商 DNS 1",
                            "Type": "ip",
                            "Default": "223.5.5.5"
                        },
                        {
                            "Key": "ISP_DNS2",
                            "Label": "运营商 DNS 2",
                            "Type": "ip",
                            "Default": "114.114.114.114"
                        },
                        {
                            "Key": "v2ray_basic_dns_chromecast",
                            "Label": "DNS 劫持",
                            "Type": "switch",
                            "Default": "1",
                            "Help": "强制局域网设备使用路由器 DNS"
                        }
                    ]
                },
                {
                    "Title": "域名名单",
                    "Tab": "黑白名单设置",
                    "Fields": [
                        {
                            "Key": "white_domain_list",
                            "Label": "域名白名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 8,
                            "Monospace": true,
                            "Placeholder": "每行一个域名，# 开头为注释",
                            "Help": "直连并走运营商 DNS，写入 white_list ipset"
                        },
                        {
                            "Key": "black_domain_list",
                            "Label": "域名黑名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 8,
                            "Monospace": true,
                            "Placeholder": "每行一个域名，# 开头为注释",
                            "Help": "走本地防污染 DNS，写入 black_list ipset"
                        }
                    ]
                },
                {
                    "Title": "IP 名单",
                    "Tab": "黑白名单设置",
                    "Fields": [
                        {
                            "Key": "white_ip_list",
                            "Label": "IP 白名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 6,
                            "Monospace": true,
                            "Placeholder": "每行一个 IP 或 CIDR，# 为注释",
                            "Help": "直连，写入 white_list ipset"
                        },
                        {
                            "Key": "black_ip_list",
                            "Label": "IP 黑名单",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 6,
                            "Monospace": true,
                            "Placeholder": "每行一个 IP 或 CIDR，# 为注释",
                            "Help": "强制走代理，写入 black_list ipset"
                        }
                    ]
                },
                {
                    "Title": "局域网 ACL",
                    "Tab": "ACL控制",
                    "Fields": [
                        {
                            "Key": "lan_acl_control",
                            "Label": "设备访问控制",
                            "Type": "textarea",
                            "Default": "",
                            "Rows": 12,
                            "Monospace": true,
                            "Placeholder": "每行一条，如：\nip=192.168.1.10 mode=1\nmac=AA:BB:CC:DD:EE:FF mode=0\nip=192.168.1.20 mac=AA:BB:CC:DD:EE:FF mode=2",
                            "Help": "mode：0不代理 / 1 GFW / 2国内 / 3游戏 / 4全局；ip、mac 可只填其一；省略 mode 则用默认代理模式"
                        }
                    ]
                },
                {
                    "Title": "UDP 与 QUIC",
                    "Tab": "UDP控制",
                    "Fields": [
                        {
                            "Key": "v2ray_udp",
                            "Label": "UDP 代理",
                            "Type": "switch",
                            "Default": "0"
                        },
                        {
                            "Key": "v2ray_udp_list",
                            "Label": "UDP 名单模式",
                            "Type": "switch",
                            "Default": "0",
                            "VisibleWhen": "v2ray_udp=1",
                            "Help": "udplist 内域名走游戏模式处理 UDP"
                        },
                        {
                            "Key": "v2ray_quic_reject",
                            "Label": "QUIC 阻断",
                            "Type": "select",
                            "Default": "0",
                            "Options": [
                                {
                                    "Label": "关闭",
                                    "Value": "0"
                                },
                                {
                                    "Label": "全局阻断",
                                    "Value": "1"
                                },
                                {
                                    "Label": "仅黑名单",
                                    "Value": "2"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    {
