#!/bin/sh

# UniFi SoftCenter · FWClient 内网穿透 · 运行状态
#
#   fwclient-status --json    面板「运行状态」按钮用（stdout 只输出 JSON）
#   fwclient-status           命令行 / 扩展按钮用（中文可读报告）
#
# 只读脚本：不改配置、不动进程、不碰防火墙。
# 注意：路由器 /bin/sh 是 busybox ash，只能用 POSIX 语法（不要用 [[ ]]、${v//}、数组）。

PATH="${FWCLIENT_PATH_PREFIX:+$FWCLIENT_PATH_PREFIX:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

PROC_NAME="fwclient-core"
PROC_ROOT="${FWCLIENT_PROC:-/proc}"          # 便于离线测试，默认 /proc
CONFIG="/data/softcenter/config/fwclient.env"
PIDFILE="/run/fwclient/fwclient.pid"
LOG="/var/log/fwclient/fwclient.log"
BIN="/data/softcenter/bin/fwclient-core"
BAR_W=22

JSON_MODE=0
[ "${1:-}" = "--json" ] && JSON_MODE=1

[ -f "$CONFIG" ] && . "$CONFIG" 2>/dev/null
GATEWAY="${FWCLIENT_GATEWAY:-}"
if [ -n "${FWCLIENT_TOKEN:-}" ]; then TOKEN_TEXT="已配置"; else TOKEN_TEXT="未配置"; fi

# ---------- 小工具 ----------
section() {
    printf '\n── %s ─────────────────────────────\n' "$1"
}

# 数值兜底：dash 的算术展开遇到空值或非数字会直接终止脚本（JSON 就没了），先归一化
num_or_zero() {
    case "$1" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "$1" ;;
    esac
}

# 柱状图：bar <值> <最大值> [宽度]
bar() {
    _v=$(num_or_zero "$1")
    _max=$(num_or_zero "$2")
    _w=$(num_or_zero "${3:-$BAR_W}")
    [ "$_w" -le 0 ] && _w=$BAR_W
    [ "$_max" -le 0 ] && _max=1
    _n=$((_v * _w / _max))
    [ "$_n" -lt 0 ] && _n=0
    [ "$_n" -gt "$_w" ] && _n=$_w
    _i=0
    _s=""
    while [ "$_i" -lt "$_w" ]; do
        if [ "$_i" -lt "$_n" ]; then
            _s="$_s█"
        else
            _s="$_s░"
        fi
        _i=$((_i + 1))
    done
    printf '%s' "$_s"
}

# 百分比数值（不带 %，四舍五入到 0.1）
pctnum() {
    _v=$(num_or_zero "$1")
    _t=$(num_or_zero "$2")
    [ "$_t" -le 0 ] && _t=1
    _p=$(( (_v * 2000 / _t + 1) / 2 ))
    printf '%d.%d' "$((_p / 10))" "$((_p % 10))"
}

# 百分比（带 %）
pct() {
    printf '%s%%' "$(pctnum "$1" "$2")"
}

# 端口助记
port_name() {
    case "$1" in
        22) echo "ssh" ;;
        23) echo "telnet" ;;
        53) echo "dns" ;;
        80) echo "http" ;;
        443) echo "https" ;;
        445) echo "smb" ;;
        3389) echo "rdp" ;;
        5900) echo "vnc" ;;
        8080) echo "http-alt" ;;
        8443) echo "https-alt" ;;
        *) echo "-" ;;
    esac
}

# TCP 状态全称
state_name() {
    case "$1" in
        ESTAB) echo "ESTABLISHED" ;;
        SYN-SENT) echo "SYN-SENT" ;;
        SYN-RECV) echo "SYN-RECV" ;;
        FIN-WAIT-1) echo "FIN-WAIT-1" ;;
        FIN-WAIT-2) echo "FIN-WAIT-2" ;;
        TIME-WAIT) echo "TIME-WAIT" ;;
        CLOSE-WAIT) echo "CLOSE-WAIT" ;;
        LAST-ACK) echo "LAST-ACK" ;;
        CLOSING) echo "CLOSING" ;;
        CLOSED) echo "CLOSED" ;;
        UNCONN) echo "UNCONN" ;;
        LISTEN) echo "LISTEN" ;;
        *) echo "$1" ;;
    esac
}

# 取某状态的连接数：state_count <"计数 状态"列表> <状态>
state_count() {
    printf '%s\n' "$1" | awk -v s="$2" '$2==s{n+=$1} END{print n+0}'
}

# 运行时长可读化
up_text() {
    [ -z "$UP_SEC" ] && {
        echo "未知"
        return
    }
    printf '%dh%02dm' "$((UP_SEC / 3600))" "$(((UP_SEC % 3600) / 60))"
}

# JSON 字符串转义
jstr() {
    printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# 内网地址判断（穿透客户端连的内网服务就是这些网段）
is_private_ip() {
    case "$1" in
        10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|169.254.*) return 0 ;;
        *) return 1 ;;
    esac
}

# ARP 表里的 MAC
arp_mac() {
    awk -v ip="$1" '$1==ip && $4!="00:00:00:00:00:00" {print $4; exit}' "$PROC_ROOT/net/arp" 2>/dev/null
}

# 结论：add_verdict <ok|warn|info> <文本>
VERDICTS=""
add_verdict() {
    if [ -z "$VERDICTS" ]; then
        VERDICTS="$1|$2"
    else
        VERDICTS="$VERDICTS
$1|$2"
    fi
}

# ---------- 找进程 ----------
PID=""
if command -v pidof >/dev/null 2>&1; then
    PID=$(pidof "$PROC_NAME" 2>/dev/null | awk '{print $1}')
fi
[ -z "$PID" ] && PID=$(pgrep -x "$PROC_NAME" 2>/dev/null | head -n1)

PIDFILE_PID=""
[ -r "$PIDFILE" ] && PIDFILE_PID=$(tr -cd '0-9' < "$PIDFILE")
NOW_TEXT=$(date '+%Y-%m-%d %H:%M:%S')

# 进程名匹配不到时，用 pid 文件 + 可执行文件确认（够稳，不怕 pid 被复用）
if [ -z "$PID" ] && [ -n "$PIDFILE_PID" ] && kill -0 "$PIDFILE_PID" 2>/dev/null \
    && [ "$(readlink "$PROC_ROOT/$PIDFILE_PID/exe" 2>/dev/null)" = "$BIN" ]; then
    PID="$PIDFILE_PID"
fi

if [ -z "$PID" ]; then
    if [ "$JSON_MODE" = "1" ]; then
        printf '{"running":false,"time":%s,"proc":%s}\n' "$(jstr "$NOW_TEXT")" "$(jstr "$PROC_NAME")"
        exit 0
    fi
    printf '════════════════ FWClient 运行状态 ════════════════\n'
    printf '时间 %s\n' "$NOW_TEXT"
    printf '客户端 未运行（进程 %s 不存在）\n' "$PROC_NAME"
    printf '\n── 建议 ────────────────────────────\n'
    printf '  · 启动：/data/softcenter/bin/fwclient start\n'
    printf '  · 日志：%s\n' "$LOG"
    printf '═══════════════════════════════════════════════════\n'
    exit 0
fi

# ---------- 运行时长 / 内存 ----------
UP_SEC=""
if [ -r "$PROC_ROOT/uptime" ] && [ -r "$PROC_ROOT/$PID/stat" ]; then
    _now=$(awk '{print int($1)}' "$PROC_ROOT/uptime" 2>/dev/null)
    _st=$(awk '{print $22}' "$PROC_ROOT/$PID/stat" 2>/dev/null)
    _hz=$(getconf CLK_TCK 2>/dev/null)
    [ -z "$_hz" ] && _hz=100
    if [ -n "$_now" ] && [ -n "$_st" ]; then
        UP_SEC=$((_now - _st / _hz))
        [ "$UP_SEC" -lt 0 ] && UP_SEC=0
    fi
fi
MEM_KB=$(awk '/^VmRSS:/{print $2}' "$PROC_ROOT/$PID/status" 2>/dev/null)
MEM_TEXT="未知"
[ -n "$MEM_KB" ] && MEM_TEXT="$((MEM_KB / 1024)).$((MEM_KB % 1024 * 10 / 1024)) MB"

# ---------- 连接 ----------
# 注意：ss -anp 的第 1 列是「连接状态」而不是协议，所以 TCP/UDP 必须分开查：
#   ss -antp / ss -anup 输出 状态 队列 本地地址:端口 对端地址:端口 进程
#   netstat -anp 输出         协议 队列 本地地址:端口 对端地址:端口 状态 进程
HAS_SS=0
SS_TCP=""
SS_UDP=""
if command -v ss >/dev/null 2>&1; then
    HAS_SS=1
    SS_TCP=$(ss -antp 2>/dev/null | grep -- "$PROC_NAME")
    SS_UDP=$(ss -anup 2>/dev/null | grep -- "$PROC_NAME")
elif command -v netstat >/dev/null 2>&1; then
    SS_TCP=$(netstat -anp 2>/dev/null | grep -- "$PROC_NAME" | grep -E '^tcp')
    SS_UDP=$(netstat -anp 2>/dev/null | grep -- "$PROC_NAME" | grep -E '^udp')
fi

# 统一成 "状态 对端地址:端口"
if [ "$HAS_SS" = "1" ]; then
    TCP_LINES=$(printf '%s\n' "$SS_TCP" | awk 'NF>=5{print $1, $5}')
    UDP_LINES=$(printf '%s\n' "$SS_UDP" | awk 'NF>=5{print $1, $5}')
else
    TCP_LINES=$(printf '%s\n' "$SS_TCP" | awk 'NF>=6{print $6, $5}')
    UDP_LINES=$(printf '%s\n' "$SS_UDP" | awk 'NF>=6{print $6, $5}')
fi

PROTO_TCP=0
[ -n "$TCP_LINES" ] && PROTO_TCP=$(printf '%s\n' "$TCP_LINES" | grep -c .)
PROTO_UDP=0
[ -n "$UDP_LINES" ] && PROTO_UDP=$(printf '%s\n' "$UDP_LINES" | grep -c .)
PROTO_TCP=$(num_or_zero "$PROTO_TCP")
PROTO_UDP=$(num_or_zero "$PROTO_UDP")
PROTO_OTHER=0
TOTAL=$((PROTO_TCP + PROTO_UDP))
PROTO_LIST=$(printf '%s\n' "tcp $PROTO_TCP" "udp $PROTO_UDP" | awk '$2>0')

TCP_STATES=$(printf '%s\n' "$TCP_LINES" | awk 'NF{print $1}' | sort | uniq -c | sort -nr)
ESTAB=$(state_count "$TCP_STATES" ESTAB)
TIME_WAIT=$(state_count "$TCP_STATES" TIME-WAIT)
SYN_SENT=$(state_count "$TCP_STATES" SYN-SENT)
CLOSE_WAIT=$(state_count "$TCP_STATES" CLOSE-WAIT)

# 对端端口 / 内网服务
PEERS=$(printf '%s\n' "$TCP_LINES" "$UDP_LINES" | awk 'NF>=2{print $2}' | grep -v '^\*')
REMOTE_TOP=$(printf '%s\n' "$PEERS" | awk -F: 'NF>=2{print $NF}' | grep -E '^[0-9]+$' | sort -n | uniq -c | sort -nr | head -n 8)
REMOTE_MAX=$(printf '%s\n' "$REMOTE_TOP" | awk 'NR==1{print $1}')
LAN_TOP=""
if [ -n "$PEERS" ]; then
    LAN_TOP=$(printf '%s\n' "$PEERS" | awk -F: 'NF>=2{print $1}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
        | while read -r _ip; do is_private_ip "$_ip" && echo "$_ip"; done \
        | sort | uniq -c | sort -nr | head -n 8)
fi
LAN_MAX=$(printf '%s\n' "$LAN_TOP" | awk 'NR==1{print $1}')

# 文件描述符
FD_COUNT=""
FD_MAX=""
[ -d "$PROC_ROOT/$PID/fd" ] && FD_COUNT=$(ls "$PROC_ROOT/$PID/fd" 2>/dev/null | wc -l | tr -d ' ')
FD_MAX=$(awk '/Max open files/{print $4}' "$PROC_ROOT/$PID/limits" 2>/dev/null)
FD_PCT=0
if [ -n "$FD_COUNT" ] && [ -n "$FD_MAX" ] && [ "$FD_MAX" -gt 0 ] 2>/dev/null; then
    FD_PCT=$((FD_COUNT * 100 / FD_MAX))
fi

# ---------- 结论 ----------
if [ "$TOKEN_TEXT" = "已配置" ] && [ -n "$GATEWAY" ]; then
    add_verdict ok "隧道进程运行中：PID $PID，已运行 $(up_text)"
else
    add_verdict warn "配置不完整：网关域名 $([ -n "$GATEWAY" ] && echo 已填 || echo 未填)、令牌 $TOKEN_TEXT"
fi
if [ -n "$PIDFILE_PID" ] && [ "$PIDFILE_PID" != "$PID" ]; then
    add_verdict info "PID 文件记录 $PIDFILE_PID，实际进程 $PID（升级或异常重启后可能不同）"
fi
if [ "$TOTAL" -eq 0 ]; then
    add_verdict warn "当前没有任何连接：若刚启动可能还在连接中，否则检查网关与令牌"
elif [ "$PROTO_TCP" -gt 0 ] && [ "$ESTAB" -eq 0 ]; then
    add_verdict warn "TCP 连接中没有 ESTABLISHED，隧道可能正在重连"
else
    add_verdict ok "连接正常：ESTABLISHED $ESTAB 条，总连接 $TOTAL"
fi
if [ -r "$LOG" ] && tail -n 50 "$LOG" 2>/dev/null | grep -Eiq 'error|fail|refused|timeout|失败|错误|超时'; then
    add_verdict info "日志近期有失败/错误记录，可在面板查看日志"
fi

# ---------- JSON 输出 ----------
if [ "$JSON_MODE" = "1" ]; then
    proto_json() {
        _sep=""
        printf '%s\n' "$PROTO_LIST" | while read -r _n _c; do
            [ -z "$_n" ] && continue
            printf '%s{"name":%s,"count":%s,"pct":%s}' "$_sep" "$(jstr "$_n")" "$_c" "$(pctnum "$_c" "$TOTAL")"
            _sep=","
        done
    }
    states_json() {
        _sep=""
        printf '%s\n' "$TCP_STATES" | while read -r _c _n; do
            [ -z "$_n" ] && continue
            printf '%s{"short":%s,"name":%s,"count":%s,"pct":%s}' \
                "$_sep" "$(jstr "$_n")" "$(jstr "$(state_name "$_n")")" "$_c" "$(pctnum "$_c" "$PROTO_TCP")"
            _sep=","
        done
    }
    ports_json() {
        _sep=""
        printf '%s\n' "$1" | while read -r _c _p; do
            [ -z "$_p" ] && continue
            printf '%s{"port":%s,"service":%s,"count":%s,"pct":%s}' \
                "$_sep" "$(jstr "$_p")" "$(jstr "$(port_name "$_p")")" "$_c" "$(pctnum "$_c" "${2:-$REMOTE_MAX}")"
            _sep=","
        done
    }
    lan_json() {
        _sep=""
        printf '%s\n' "$LAN_TOP" | while read -r _c _ip; do
            [ -z "$_ip" ] && continue
            printf '%s{"ip":%s,"name":"-","mac":"%s","count":%s,"pct":%s}' \
                "$_sep" "$(jstr "$_ip")" "$(arp_mac "$_ip")" "$_c" "$(pctnum "$_c" "$LAN_MAX")"
            _sep=","
        done
    }
    verdict_json() {
        _sep=""
        printf '%s\n' "$VERDICTS" | while IFS= read -r _line; do
            [ -z "$_line" ] && continue
            printf '%s{"level":"%s","text":%s}' "$_sep" "${_line%%|*}" "$(jstr "${_line#*|}")"
            _sep=","
        done
    }
    printf '{'
    printf '"time":%s,' "$(jstr "$NOW_TEXT")"
    printf '"running":true,'
    printf '"pid":"%s",' "$PID"
    printf '"uptime":%s,' "$(jstr "$(up_text)")"
    printf '"mem":%s,' "$(jstr "$MEM_TEXT")"
    printf '"mode":%s,' "$(jstr "内网穿透 · 网关 ${GATEWAY:--}")"
    printf '"total":%s,"tcp":%s,"udp":%s,"other":%s,' "$TOTAL" "$PROTO_TCP" "$PROTO_UDP" "$PROTO_OTHER"
    printf '"fd":{"count":"%s","max":"%s","pct":%s},' "$FD_COUNT" "$FD_MAX" "$FD_PCT"
    printf '"proto":[%s],' "$(proto_json)"
    printf '"states":[%s],' "$(states_json)"
    printf '"remote_ports":[%s],' "$(ports_json "$REMOTE_TOP" "$REMOTE_MAX")"
    printf '"lan":[%s],' "$(lan_json)"
    printf '"verdicts":[%s]' "$(verdict_json)"
    printf '}\n'
    exit 0
fi

# ---------- 文本报告 ----------
printf '════════════════ FWClient 运行状态 ════════════════\n'
printf '时间 %s\n' "$NOW_TEXT"
printf '客户端 PID %s   运行 %s   内存 %s\n' "$PID" "$(up_text)" "$MEM_TEXT"
printf '网关 %s   令牌 %s   日志 %s\n' "${GATEWAY:--}" "$TOKEN_TEXT" "$LOG"

section "连接概览"
printf '  总连接 %s   TCP %s   UDP %s   其它 %s\n' "$TOTAL" "$PROTO_TCP" "$PROTO_UDP" "$PROTO_OTHER"
printf '  TCP 状态：ESTABLISHED %s   TIME-WAIT %s   SYN-SENT %s   CLOSE-WAIT %s\n' \
    "$ESTAB" "$TIME_WAIT" "$SYN_SENT" "$CLOSE_WAIT"

section "协议分布"
if [ -n "$PROTO_LIST" ]; then
    printf '%s\n' "$PROTO_LIST" | while read -r _n _c; do
        [ -z "$_n" ] && continue
        printf '  %-6s %s %s (%s)\n' "$_n" "$(bar "$_c" "$TOTAL")" "$_c" "$(pct "$_c" "$TOTAL")"
    done
else
    printf '  （无连接）\n'
fi

section "对端端口 Top"
if [ -n "$REMOTE_TOP" ]; then
    printf '%s\n' "$REMOTE_TOP" | while read -r _c _p; do
        [ -z "$_p" ] && continue
        printf '  %-6s %-10s %s %s (%s)\n' "$_p" "$(port_name "$_p")" "$(bar "$_c" "$REMOTE_MAX")" "$_c" "$(pct "$_c" "$REMOTE_MAX")"
    done
else
    printf '  （无连接）\n'
fi

section "内网服务（被访问的局域网地址）"
if [ -n "$LAN_TOP" ]; then
    printf '%s\n' "$LAN_TOP" | while read -r _c _ip; do
        [ -z "$_ip" ] && continue
        printf '  %-15s MAC %-17s %s %s 会话\n' "$_ip" "$(arp_mac "$_ip")" "$(bar "$_c" "$LAN_MAX" 12)" "$_c"
    done
else
    printf '  （暂无内网连接）\n'
fi

section "进程资源"
printf '  文件描述符 %s / %s (%s%%)\n' "${FD_COUNT:--}" "${FD_MAX:--}" "$FD_PCT"
printf '  内存占用   %s\n' "$MEM_TEXT"

section "结论"
printf '%s\n' "$VERDICTS" | while IFS= read -r _line; do
    [ -z "$_line" ] && continue
    case "${_line%%|*}" in
        ok) _tag="✓" ;;
        warn) _tag="⚠" ;;
        *) _tag="ⓘ" ;;
    esac
    printf '  %s %s\n' "$_tag" "${_line#*|}"
done
printf '═══════════════════════════════════════════════════\n'
